caption: KIKS-Details
tags: form
title: $:/plugins/aeckert/cypro/pages/listKIKSDetail
type: text/vnd.tiddlywiki

<!--
  listKIKSDetail — a richer KIKS overview table (ID, name, max applicable risk, and the
  linked measures). Note: pages/listKIKS itself is an empty anchor rendered by
  viewtemplates/form/listKIKS (which shows a 3-column version); this "Detail" page adds
  the Maßnahmen column. Both exist — see the architecture notes about this overlap.
-->
<table class="cypro-table">
<thead>
<tr>
<th>ID</th>
<th>Bezeichnung</th>
<th class="center">Max. Risiko</th>
<th>Maßnahmen</th>
</tr>
</thead>
<tbody>
<$list filter="[tag[KIKS]sort[id]]">
<tr>
<td><$link to=<<currentTiddler>>>{{!!id}}</$link></td>
<td><$macrocall $name="cypro-kiks-caption" t=<<currentTiddler>>/></td>
<td class="center bold">
<$let
    initialMax={{{ [tag[threat]kiks<currentTiddler>applicable[yes]get[initial_risk]nsort[]last[]] }}}
    finalMax={{{ [tag[threat]kiks<currentTiddler>applicable[yes]get[final_risk]nsort[]last[]] }}}
    packageCount={{{ [tag[threat]kiks<currentTiddler>applicable[yes]has[package_impact]has[package_probability]count[]] }}}
>
<span class="cypro-risk-transition" title="Maximales Ausgangsrisiko; nach abgeschlossener Maßnahmenpaket-Neubewertung: Ausgangsrisiko → Restrisiko">
<$list filter="[<initialMax>!is[blank]]" variable="null" emptyMessage="–">
<span class="cypro-risk-transition-initial"><$text text=<<initialMax>>/></span>
</$list>
<$list filter="[<packageCount>compare:number:gt[0]]" variable="null">
<span class="cypro-risk-transition-arrow">→</span>
<$list filter="[<finalMax>compare:number:gteq[10]]" variable="null">
<span class="kiks-risk-alert cypro-risk-transition-final"><$text text=<<finalMax>>/></span>
</$list>
<$list filter="[<finalMax>compare:number:lt[10]]" variable="null">
<span class="cypro-risk-transition-final"><$text text=<<finalMax>>/></span>
</$list>
</$list>
</span>
</$let>
</td>
<td class="muted"><$set name="kiksTitle" value=<<currentTiddler>>><$list filter="[tag[threat]kiks<kiksTitle>tagging[]tag[measure]sort[id]]" variable="mTiddler"><$link to=<<mTiddler>>><$view tiddler=<<mTiddler>> field="id"/></$link> </$list></$set></td>
</tr>
</$list>
</tbody>
</table>

<!-- Prepared/preset KIKS offerings (data-driven; see components/presetKIKS) -->
<$transclude tiddler="$:/plugins/aeckert/cypro/viewtemplates/components/presetKIKS"/>
