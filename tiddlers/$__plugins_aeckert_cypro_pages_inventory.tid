\define render-aviation-tasks(sourceTiddler)

<!-- Show the explicit "none" selection. -->
<$list
    filter="[[$sourceTiddler$]get[aviation-security-task-none]match[yes]]"
    variable="null"
>
<div class="cypro-task-display-item">
Keine Luftsicherheitsaufgabe
</div>
</$list>


<!-- Render all selected aviation security tasks. -->
<$list
    filter="[[$sourceTiddler$]get[aviation-security-tasks]enlist-input[]]"
    variable="task"
>

<div class="cypro-task-display-item">

<$list filter="[<task>match[access-control]]" variable="null">
• Zugangssicherung
</$list>

<$list filter="[<task>match[passenger-baggage-screening]]" variable="null">
• Personen- und Gepäckkontrollen
</$list>

<$list filter="[<task>match[air-cargo-security]]" variable="null">
• Luftfrachtsicherheit
</$list>

<$list filter="[<task>match[personnel-screening]]" variable="null">
• Personalüberprüfung
</$list>

<$list filter="[<task>match[surveillance-interference-protection]]" variable="null">
• Überwachung und Schutz vor unbefugtem Eingreifen
</$list>

<$list filter="[<task>match[training-records]]" variable="null">
• Schulungsnachweise
</$list>

<$list filter="[<task>match[security-programmes]]" variable="null">
• Sicherheitsprogramme
</$list>

<$list filter="[<task>match[other]]" variable="null">
• Sonstige
<$list
    filter="[[$sourceTiddler$]get[aviation-security-task-other]minlength[1]]"
    variable="otherText"
>
: <$text text=<<otherText>>/>
</$list>
</$list>

</div>


<!-- Render cargo-specific subcategories. -->
<$list
    filter="[<task>match[air-cargo-security]]"
    variable="null"
>

<$list
    filter="[[$sourceTiddler$]get[aviation-security-cargo-tasks]enlist-input[]]"
    variable="cargoTask"
>

<div class="cypro-task-display-subitem">

<$list filter="[<cargoTask>match[cargo-unauthorised-interference]]" variable="null">
– Schutz vor unbefugtem Eingreifen
</$list>

<$list filter="[<cargoTask>match[cargo-secure-supply-chain]]" variable="null">
– Sicherheit innerhalb der sicheren Lieferkette
</$list>

<$list filter="[<cargoTask>match[cargo-shipment-status]]" variable="null">
– Sendungsstatus
</$list>

</div>

</$list>

</$list>

</$list>


<!-- Show a dash for legacy entries without an assignment. -->
<$list
    filter="[[$sourceTiddler$]get[aviation-security-task-none]!match[yes]]"
    variable="null"
>
<$list
    filter="[[$sourceTiddler$]get[aviation-security-tasks]enlist-input[]count[]match[0]]"
    variable="null"
>
<div class="cypro-task-display-item">
–
</div>
</$list>
</$list>

\end


<!-- Create one persistent inventory entry. -->
\define cypro-add-inventory()

<$vars
    maxNum={{{ [tag[cypro-inventory]prefix[CyPro-Inventar-]removeprefix[CyPro-Inventar-]nsort[]last[]] ~[[000]] }}}
>

<$vars
    nextNum={{{ [<maxNum>add[1]pad[3]] }}}
>

<$vars
    newTitle={{{ [<nextNum>addprefix[CyPro-Inventar-]] }}}
>

<$set
    name="hasAviationTask"
    filter="[<inventory-input>get[aviation-security-tasks]minlength[1]]"
    value="yes"
    emptyValue="no"
>

<$action-createtiddler
    $basetitle=<<newTitle>>
    tags="cypro-inventory"
    inventory-id=<<nextNum>>
    caption={{$:/temp/cypro/inventory-new!!caption}}
    object-type={{$:/temp/cypro/inventory-new!!object-type}}
    aviation-security-tasks={{$:/temp/cypro/inventory-new!!aviation-security-tasks}}
    aviation-security-cargo-tasks={{$:/temp/cypro/inventory-new!!aviation-security-cargo-tasks}}
    aviation-security-task-other={{$:/temp/cypro/inventory-new!!aviation-security-task-other}}
    aviation-security-task-none={{{ [<hasAviationTask>match[no]then[yes]] }}}
    assessment-status={{{ [<hasAviationTask>match[yes]then[pending]else[completed]] }}}
    assessment-result={{{ [<hasAviationTask>match[no]then[non-kiks]] }}}
    assessment-reason={{{ [<hasAviationTask>match[no]then[no-aviation-task]] }}}
    text=""
/>

</$set>

<$action-setfield
    $tiddler=<<inventory-input>>
    caption=""
    object-type=""
    aviation-security-tasks=""
    aviation-security-cargo-tasks=""
    aviation-security-task-other=""
    aviation-security-task-none=""
/>

</$vars>
</$vars>
</$vars>

\end


\define cypro-add-inventory-button()

<$button
    class="cypro-btn cypro-btn-primary"
    actions=<<cypro-add-inventory>>
>
Zur Liste hinzufügen
</$button>

\end


