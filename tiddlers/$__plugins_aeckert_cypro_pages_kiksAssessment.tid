    jurisdiction-reason=""
    assessment-status="completed"
    assessment-result="non-kiks"
    assessment-reason="no-aviation-impact"
/>

</$list>


<$list
    filter="[<assessment-draft>get[confirmed-type]match[data]] [<assessment-draft>get[confirmed-type]match[system]get[system-protection]match[system]]"
