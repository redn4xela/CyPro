\import [[$:/plugins/aeckert/cypro/macros/editControl]]

\define threat-applicability-badge()
<$list filter="[<threatTiddler>get[applicable]match[yes]]" variable="null">
<span class="cypro-applicability-badge cypro-applicability-yes">Anwendbar</span>
</$list>
<$list filter="[<threatTiddler>get[applicable]match[no]]" variable="null">
<span class="cypro-applicability-badge cypro-applicability-no">Nicht anwendbar</span>
</$list>
<$list filter="[<threatTiddler>get[applicable]!match[yes]!match[no]]" variable="null">
<span class="cypro-applicability-badge cypro-applicability-open">Offen</span>
</$list>
\end

\define render-threat-grid-row()
<$let
    threatId={{{ [<threatTiddler>get[title]] }}}
    threatCaption={{{ [<threatTiddler>get[caption]else<threatId>] }}}
    threatRisk={{{ [<threatTiddler>get[final_risk]] }}}
    protectionScore={{{ [<threatTiddler>get[protection_score]else[0]] }}}
    snapshotTitle={{{ [<threatTiddler>addprefix[$:/state/cypro/snapshot/]] }}}
    rowClass={{{ [<threatTiddler>get[applicable]match[no]then[cypro-threat-grid-row cypro-threat-row-inactive]else[cypro-threat-grid-row]] }}}
    tourClass={{{ [<threatId>match[K01T07]then[cypro-tour-threat-row]] }}}
>

<div class={{{ [<rowClass>] [<tourClass>] +[join[ ]] }}}>

<div class="cypro-threat-grid-cell cypro-threat-grid-action">

<$tiddler tiddler=<<threatTiddler>> islink="no">
<$button class="cypro-btn cypro-btn-secondary cypro-threat-measures-button" tooltip="Gefährdung bewerten und Maßnahmen anpassen">
<$list filter="[<snapshotTitle>!is[tiddler]]" variable="null">
<<cypro-snapshot>>
</$list>
<$action-navigate $to=<<threatTiddler>>/>
<span class="cypro-btn-label">Maßnahmen anpassen</span>
</$button>
</$tiddler>
</div>

<div class="cypro-threat-grid-cell cypro-threat-grid-applicability">

<<threat-applicability-badge>>
</div>

<div class="cypro-threat-grid-cell cypro-threat-grid-number">

<$macrocall $name="cypro-threat-no-label" t=<<threatTiddler>>/>
</div>

<div class="cypro-threat-grid-cell cypro-threat-grid-caption">

<$text text=<<threatCaption>>/>
</div>

<div class="cypro-threat-grid-cell cypro-threat-grid-risk">

<$list filter="[<threatTiddler>get[applicable]match[yes]]" variable="null">
<$macrocall $name="cypro-risk-badge" value=<<threatRisk>>/>
</$list>
<$list filter="[<threatTiddler>get[applicable]!match[yes]]" variable="null">
<span class="muted">–</span>
</$list>
</div>

<div class="cypro-threat-grid-cell cypro-threat-grid-protection">

<$list filter="[<threatTiddler>get[applicable]match[yes]]" variable="null">
<$macrocall $name="cypro-mini-protection" score=<<protectionScore>>/>
</$list>
<$list filter="[<threatTiddler>get[applicable]!match[yes]]" variable="null">
<span class="muted">–</span>
</$list>
</div>

</div>

</$let>
\end

<div class="kiks-body-area">

<div class="kiks-field-label">

Gefährdungen:</div>

<$let kiksId={{{ [<currentTiddler>get[id]] }}}>

<$list
    filter="[tag[threat]kiks<kiksId>limit[1]]"
    emptyMessage="<div class='kiks-empty-message'>Noch keine Bedrohungen erfasst.</div>"
    variable="null"
>

<div class="cypro-threat-grid-wrap">

<div class="cypro-threat-grid-table">

<div class="cypro-threat-grid-header">

<div>

Aktion</div>
<div>

Anwendbarkeit</div>
<div>

Gefährdungsnr.</div>
<div>

Gefährdung</div>
<div>

Risikowert</div>
<div>

Schutzgrad</div>
</div>

<div class="cypro-threat-grid-body">

<$list filter="[tag[threat]kiks<kiksId>applicable[yes]sort[threat_no]each[id]]" variable="threatTiddler">
<<render-threat-grid-row>>
</$list>

<$list filter="[tag[threat]kiks<kiksId>!applicable[yes]!applicable[no]sort[threat_no]each[id]]" variable="threatTiddler">
<<render-threat-grid-row>>
</$list>

<$list filter="[tag[threat]kiks<kiksId>applicable[no]sort[threat_no]each[id]]" variable="threatTiddler">
<<render-threat-grid-row>>
</$list>

</div>

</div>

</div>

</$list>

<div class="cypro-threat-grid-footer">

<$button
    class="cypro-btn cypro-btn-secondary"
    tooltip="Neue Bedrohung anlegen"
    actions=<<threat-create-action>>
>
<span class="cypro-btn-label">Neue Bedrohung</span>
</$button>
</div>

</$let>

</div>
