\import [[$:/plugins/aeckert/cypro/macros/editControl]]

\define threat-applicability-badge()
<$list filter="[<threatTiddler>get[applicable]match[yes]]" variable="null">
<span class="cypro-applicability-badge cypro-applicability-yes">Anwendbar</span>
</$list>
<$list filter="[<threatTiddler>get[applicable]match[no]]" variable="null">
<span class="cypro-applicability-badge cypro-applicability-no">Nicht anwendbar</span>
</$list>
<$list filter="[<threatTiddler>get[applicable]!match[yes]!match[no]]" variable="null">
<span class="cypro-applicability-badge cypro-applicability-open">Offen</span>
</$list>
\end

\define render-threat-row()
<$let
    threatId={{{ [<threatTiddler>get[title]] }}}
    threatCaption={{{ [<threatTiddler>get[caption]else<threatId>] }}}
    snapshotTitle={{{ [<threatTiddler>addprefix[$:/state/cypro/snapshot/]] }}}
    inactiveClass={{{ [<threatTiddler>get[applicable]match[no]then[cypro-threat-row-inactive]] }}}
    tourClass={{{ [<threatId>match[K01T07]then[cypro-tour-threat-row]] }}}
>
<tr class={{{ [<inactiveClass>] [<tourClass>] +[join[ ]] }}}>
<td class="threat-action-col">
<$tiddler tiddler=<<threatTiddler>> islink="no">
<$button class="cypro-btn cypro-btn-secondary cypro-threat-measures-button" tooltip="Gefährdung bewerten und Maßnahmen anpassen">
<$list filter="[<snapshotTitle>!is[tiddler]]" variable="null">
<<cypro-snapshot>>
</$list>
<$action-navigate $to=<<threatTiddler>>/>
<span class="cypro-btn-label">Maßnahmen anpassen</span>
</$button>
</$tiddler>
</td>
<td class="threat-appl-cell"><<threat-applicability-badge>></td>
<td class="threat-number-col"><$macrocall $name="cypro-threat-no-label" t=<<threatTiddler>>/></td>
<td class="threat-caption-col"><$text text=<<threatCaption>>/></td>
<td class="threat-risk-cell">
<$list filter="[<threatTiddler>get[applicable]match[yes]]" variable="null">
<$list filter="[<threatTiddler>get[final_risk]compare:number:gteq[10]]" variable="null">
<span class="kiks-risk-alert"><$transclude tiddler=<<threatTiddler>> field="final_risk"/></span>
</$list>
<$list filter="[<threatTiddler>get[final_risk]compare:number:lt[10]]" variable="null">
<$transclude tiddler=<<threatTiddler>> field="final_risk"/>
</$list>
</$list>
</td>
</tr>
</$let>
\end

<div class="kiks-body-area">
<div class="kiks-field-label">Gefährdungen:</div>
<$let kiksId={{{ [<currentTiddler>get[id]] }}}>
<$list filter="[tag[threat]kiks<kiksId>limit[1]]" emptyMessage="<div class='kiks-empty-message'>Noch keine Bedrohungen erfasst.</div>" variable="null">
<div class="cypro-table-wrap">
<table class="threat-table tc-table cypro-fixed-table">
<colgroup>
<col style="width:18%;">
<col style="width:15%;">
<col style="width:12%;">
<col style="width:43%;">
<col style="width:12%;">
</colgroup>
<thead>
<tr>
<th>Aktion</th>
<th>Anwendbarkeit</th>
<th>Gefährdungsnr.</th>
<th>Gefährdung</th>
<th class="threat-risk-cell">Risikowert</th>
</tr>
</thead>
<tbody>
<$list filter="[tag[threat]kiks<kiksId>applicable[yes]sort[threat_no]each[id]]" variable="threatTiddler">
<<render-threat-row>>
</$list>
<$list filter="[tag[threat]kiks<kiksId>!applicable[yes]!applicable[no]sort[threat_no]each[id]]" variable="threatTiddler">
<<render-threat-row>>
</$list>
<$list filter="[tag[threat]kiks<kiksId>applicable[no]sort[threat_no]each[id]]" variable="threatTiddler">
<<render-threat-row>>
</$list>
</tbody>
</table>
</div>
</$list>
<$button class="cypro-btn cypro-btn-secondary" tooltip="Neue Bedrohung anlegen" actions=<<threat-create-action>>>
<span class="cypro-btn-label">Neue Bedrohung</span>
</$button>
</$let>
</div>
