title: $:/plugins/aeckert/cypro/viewtemplates/threat/measures
type: text/vnd.tiddlywiki

\define render-measure-status()
<$list filter="[<measureTiddler>get<statusField>match[implemented]]" variable="null"><span class="cypro-measure-status-badge cypro-status-implemented">Umgesetzt</span></$list>
<$list filter="[<measureTiddler>get<statusField>match[planned]]" variable="null"><span class="cypro-measure-status-badge cypro-status-planned">In Planung</span></$list>
<$list filter="[<measureTiddler>get<statusField>match[not-implemented]]" variable="null"><span class="cypro-measure-status-badge cypro-status-not-implemented">Nicht umgesetzt</span></$list>
<$list filter="[<measureTiddler>get<statusField>match[financially-not-possible]]" variable="null"><span class="cypro-measure-status-badge cypro-status-financial">Finanziell nicht möglich</span></$list>
<$list filter="[<measureTiddler>get<statusField>minlength[1]count[]match[0]]" variable="null"><span class="cypro-measure-status-badge cypro-status-legacy">Bestand</span></$list>
\end

\define render-measure-status-options()
<div class="cypro-measure-status-options">

<label><$radio tiddler=<<measureTiddler>> field=<<statusField>> value="implemented" actions="""
<$action-setfield $tiddler=<<currentTag>> package_impact="" package_probability=""/>
<$macrocall $name="update-risk-actions" threat=<<currentTag>>/>
"""/>Umgesetzt</label>
<label><$radio tiddler=<<measureTiddler>> field=<<statusField>> value="planned" actions="""
<$action-setfield $tiddler=<<currentTag>> package_impact="" package_probability=""/>
<$macrocall $name="update-risk-actions" threat=<<currentTag>>/>
"""/>In Planung</label>
<label><$radio tiddler=<<measureTiddler>> field=<<statusField>> value="not-implemented" actions="""
<$action-setfield $tiddler=<<currentTag>> package_impact="" package_probability=""/>
<$macrocall $name="update-risk-actions" threat=<<currentTag>>/>
"""/>Nicht umgesetzt</label>
<label><$radio tiddler=<<measureTiddler>> field=<<statusField>> value="financially-not-possible" actions="""
<$action-setfield $tiddler=<<currentTag>> package_impact="" package_probability=""/>
<$macrocall $name="update-risk-actions" threat=<<currentTag>>/>
"""/>Finanziell nicht möglich</label>
</div>
\end

\define coverage-chip(key,label)
<$let
    implementedFunctionCount={{{ [tag[measure]tag<currentTag>field:control-function[$key$]] :filter[get<statusField>match[implemented]] +[count[]] }}}
    plannedFunctionCount={{{ [tag[measure]tag<currentTag>field:control-function[$key$]] :filter[get<statusField>match[planned]] +[count[]] }}}
>
<$list filter="[<implementedFunctionCount>compare:number:gt[0]]" variable="null"><span class="cypro-coverage-chip cypro-coverage-chip-implemented">✓ $label$</span></$list>
<$list filter="[<implementedFunctionCount>compare:number:eq[0]]" variable="null">
<$list filter="[<plannedFunctionCount>compare:number:gt[0]]" variable="null"><span class="cypro-coverage-chip cypro-coverage-chip-planned">◷ $label$</span></$list>
<$list filter="[<plannedFunctionCount>compare:number:eq[0]]" variable="null"><span class="cypro-coverage-chip">○ $label$</span></$list>
</$list>
</$let>
\end

\define package-impact-scale()
<div class="cypro-package-scale">

<$let fieldParam="package_impact" labelParam="Schadenshöhe nach Maßnahmenpaket:" o1Param="vernachlässigbar" o2Param="begrenzt" o3Param="beträchtlich" o4Param="existenzbedrohend">
{{||$:/plugins/aeckert/cypro/viewtemplates/components/scaleRadio}}
</$let>

</div>
\end

\define package-probability-scale()
<div class="cypro-package-scale">

<$let fieldParam="package_probability" labelParam="Eintrittshäufigkeit nach Maßnahmenpaket:" o1Param="selten" o2Param="mittel" o3Param="häufig" o4Param="sehr häufig">
{{||$:/plugins/aeckert/cypro/viewtemplates/components/scaleRadio}}
</$let>

</div>
\end

\define cypro-protection-gauge()

<$let
    implementedMeasures={{{ [tag[measure]tag<currentTag>] :filter[get<statusField>match[implemented]] +[count[]] }}}
    plannedMeasures={{{ [tag[measure]tag<currentTag>] :filter[get<statusField>match[planned]] +[count[]] }}}

    implementedPrevention={{{ [tag[measure]tag<currentTag>field:control-function[prevention]] :filter[get<statusField>match[implemented]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    implementedDetection={{{ [tag[measure]tag<currentTag>field:control-function[detection]] :filter[get<statusField>match[implemented]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    implementedResponse={{{ [tag[measure]tag<currentTag>field:control-function[response]] :filter[get<statusField>match[implemented]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    implementedRecovery={{{ [tag[measure]tag<currentTag>field:control-function[recovery]] :filter[get<statusField>match[implemented]] +[count[]compare:number:gt[0]then[1]else[0]] }}}

    plannedPrevention={{{ [tag[measure]tag<currentTag>field:control-function[prevention]] :filter[get<statusField>match[planned]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    plannedDetection={{{ [tag[measure]tag<currentTag>field:control-function[detection]] :filter[get<statusField>match[planned]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    plannedResponse={{{ [tag[measure]tag<currentTag>field:control-function[response]] :filter[get<statusField>match[planned]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    plannedRecovery={{{ [tag[measure]tag<currentTag>field:control-function[recovery]] :filter[get<statusField>match[planned]] +[count[]compare:number:gt[0]then[1]else[0]] }}}

    packageBonus={{{ [<currentTag>has[package_impact]has[package_probability]then[10]else[0]] }}}
>

<$let
    implementedCategoryCount={{{ [<implementedPrevention>add<implementedDetection>add<implementedResponse>add<implementedRecovery>] }}}
    implementedMeasureCap={{{ [<implementedMeasures>min[6]] }}}

    potentialPrevention={{{ [<implementedPrevention>add<plannedPrevention>compare:number:gt[0]then[1]else[0]] }}}
    potentialDetection={{{ [<implementedDetection>add<plannedDetection>compare:number:gt[0]then[1]else[0]] }}}
    potentialResponse={{{ [<implementedResponse>add<plannedResponse>compare:number:gt[0]then[1]else[0]] }}}
    potentialRecovery={{{ [<implementedRecovery>add<plannedRecovery>compare:number:gt[0]then[1]else[0]] }}}

    potentialMeasureCount={{{ [<implementedMeasures>add<plannedMeasures>min[6]] }}}
>

<$let
    potentialCategoryCount={{{ [<potentialPrevention>add<potentialDetection>add<potentialResponse>add<potentialRecovery>] }}}
    implementedCategoryScore={{{ [<implementedCategoryCount>multiply[15]] }}}
    implementedMeasureScore={{{ [<implementedMeasureCap>multiply[5]] }}}
    potentialCategoryScore={{{ [<potentialCategoryCount>multiply[15]] }}}
    potentialMeasureScore={{{ [<potentialMeasureCount>multiply[5]] }}}
>

<$let
    protectionScore={{{ [<implementedCategoryScore>add<implementedMeasureScore>add<packageBonus>min[100]] }}}
    potentialScore={{{ [<potentialCategoryScore>add<potentialMeasureScore>add<packageBonus>min[100]] }}}
>

<$let
    needleAngle={{{ [<protectionScore>multiply[18]divide[10]add[-90]] }}}
    potentialNeedleAngle={{{ [<potentialScore>multiply[18]divide[10]add[-90]] }}}
>

<div
    class="cypro-protection-panel"
    style={{{ [<needleAngle>addprefix[--cypro-protection-angle:]addsuffix[deg;]] [<potentialNeedleAngle>addprefix[--cypro-potential-angle:]addsuffix[deg;]] +[join[]] }}}
>

<div class="cypro-protection-heading">

<div>

<h4>Aktueller Schutzgrad</h4>
<div class="cypro-protection-subtitle">

Orientierungswert für Breite und Umsetzungsstand des Maßnahmenpakets.
</div>
</div>

<div class="cypro-protection-value">

<strong><$text text=<<protectionScore>>/> / 100</strong>

<$list filter="[<protectionScore>compare:number:lt[40]]" variable="null">
<span class="cypro-protection-band cypro-protection-band-red">Handlungsbedarf</span>
</$list>

<$list
    filter="[<protectionScore>compare:number:gteq[40]compare:number:lt[70]]"
    variable="null"
>
<span class="cypro-protection-band cypro-protection-band-yellow">
Weitere Maßnahmen können hilfreich sein
</span>
</$list>

<$list filter="[<protectionScore>compare:number:gteq[70]]" variable="null">
<span class="cypro-protection-band cypro-protection-band-green">
Breite Maßnahmenabdeckung
</span>
</$list>

</div>
</div>

<div class="cypro-protection-gauge-wrap">

<div class="cypro-protection-gauge">

<div class="cypro-protection-gauge-arc">

</div>
<div class="cypro-protection-needle">

</div>

<$list
    filter="[<plannedMeasures>compare:number:gt[0]] [<potentialScore>compare:number:gt<protectionScore>] +[count[]match[2]]"
    variable="null"
>
<div class="cypro-protection-needle cypro-protection-needle-potential">

</div>
</$list>

<div class="cypro-protection-hub">

</div>

<div class="cypro-protection-gauge-label cypro-protection-label-left">

0</div>
<div class="cypro-protection-gauge-label cypro-protection-label-red">

40</div>
<div class="cypro-protection-gauge-label cypro-protection-label-yellow">

70</div>
<div class="cypro-protection-gauge-label cypro-protection-label-right">

100</div>

</div>

<div class="cypro-protection-legend">

<div>

<span class="cypro-protection-legend-line cypro-protection-legend-current"></span>
Aktuell – nur umgesetzt
</div>

<$list filter="[<plannedMeasures>compare:number:gt[0]]" variable="null">
<div>

<span class="cypro-protection-legend-line cypro-protection-legend-potential"></span>
Mit geplanten Maßnahmen:
<strong><$text text=<<potentialScore>>/> / 100</strong>
</div>
</$list>

</div>

</div>

<div class="cypro-protection-explanation">

<div class="cypro-protection-formula">

<span>
<strong><$text text=<<implementedCategoryCount>>/> / 4</strong>
Funktionsbereiche umgesetzt
</span>

<span>
<strong><$text text=<<implementedMeasures>>/></strong>
Maßnahmen umgesetzt
</span>

<$list filter="[<packageBonus>match[10]]" variable="null">
<span>
<strong>+10</strong>
Paket neu bewertet
</span>
</$list>

</div>

<div class="cypro-protection-note">

Der Schutzgrad ist kein Risikowert. Er bewertet transparent die Breite des
umgesetzten Maßnahmenpakets. Das Restrisiko wird weiterhin separat über
Schadenshöhe und Eintrittshäufigkeit nach dem umgesetzten Maßnahmenpaket bewertet.
</div>

</div>

<$list filter="[<protectionScore>compare:number:lt[70]]" variable="null">

<div class="cypro-protection-gaps">

<strong>Noch hilfreiche Ergänzungsbereiche:</strong>

<$list filter="[<potentialPrevention>match[0]]" variable="null">
<span class="cypro-gap-chip cypro-gap-chip-open">Prävention</span>
</$list>

<$list filter="[<potentialDetection>match[0]]" variable="null">
<span class="cypro-gap-chip cypro-gap-chip-open">Erkennung</span>
</$list>

<$list filter="[<potentialResponse>match[0]]" variable="null">
<span class="cypro-gap-chip cypro-gap-chip-open">Reaktion</span>
</$list>

<$list filter="[<potentialRecovery>match[0]]" variable="null">
<span class="cypro-gap-chip cypro-gap-chip-open">
Wiederherstellung / Resilienz
</span>
</$list>

<$list
    filter="[<implementedPrevention>match[0]] [<plannedPrevention>match[1]] +[count[]match[2]]"
    variable="null"
>
<span class="cypro-gap-chip cypro-gap-chip-planned">Prävention in Planung</span>
</$list>

<$list
    filter="[<implementedDetection>match[0]] [<plannedDetection>match[1]] +[count[]match[2]]"
    variable="null"
>
<span class="cypro-gap-chip cypro-gap-chip-planned">Erkennung in Planung</span>
</$list>

<$list
    filter="[<implementedResponse>match[0]] [<plannedResponse>match[1]] +[count[]match[2]]"
    variable="null"
>
<span class="cypro-gap-chip cypro-gap-chip-planned">Reaktion in Planung</span>
</$list>

<$list
    filter="[<implementedRecovery>match[0]] [<plannedRecovery>match[1]] +[count[]match[2]]"
    variable="null"
>
<span class="cypro-gap-chip cypro-gap-chip-planned">
Wiederherstellung / Resilienz in Planung
</span>
</$list>

</div>

</$list>

</div>

</$let>
</$let>
</$let>
</$let>
</$let>

\end


\define cypro-catalog-gap-badge()

<$let
    catalogFunction={{{ [<catalogItem>get[control-function]] }}}
    implementedFunctionCount={{{ [tag[measure]tag<currentTag>field:control-function<catalogFunction>] :filter[get<statusField>match[implemented]] +[count[]] }}}
    plannedFunctionCount={{{ [tag[measure]tag<currentTag>field:control-function<catalogFunction>] :filter[get<statusField>match[planned]] +[count[]] }}}

    implementedMeasuresForScore={{{ [tag[measure]tag<currentTag>] :filter[get<statusField>match[implemented]] +[count[]min[6]] }}}
    implementedPreventionForScore={{{ [tag[measure]tag<currentTag>field:control-function[prevention]] :filter[get<statusField>match[implemented]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    implementedDetectionForScore={{{ [tag[measure]tag<currentTag>field:control-function[detection]] :filter[get<statusField>match[implemented]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    implementedResponseForScore={{{ [tag[measure]tag<currentTag>field:control-function[response]] :filter[get<statusField>match[implemented]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    implementedRecoveryForScore={{{ [tag[measure]tag<currentTag>field:control-function[recovery]] :filter[get<statusField>match[implemented]] +[count[]compare:number:gt[0]then[1]else[0]] }}}
    packageBonusForScore={{{ [<currentTag>has[package_impact]has[package_probability]then[10]else[0]] }}}
>

<$let
    implementedCategoriesForScore={{{ [<implementedPreventionForScore>add<implementedDetectionForScore>add<implementedResponseForScore>add<implementedRecoveryForScore>] }}}
>

<$let
    categoryProtectionScore={{{ [<implementedCategoriesForScore>multiply[15]] }}}
    measureProtectionScore={{{ [<implementedMeasuresForScore>multiply[5]] }}}
>

<$let
    recommendationScore={{{ [<categoryProtectionScore>add<measureProtectionScore>add<packageBonusForScore>min[100]] }}}
>

<$list
    filter="[<implementedFunctionCount>compare:number:eq[0]] [<plannedFunctionCount>compare:number:eq[0]] +[count[]match[2]]"
    variable="null"
>

<$list filter="[<recommendationScore>compare:number:lt[40]]" variable="null">
<span class="cypro-catalog-gap-badge cypro-catalog-gap-red">
Hoher Ergänzungsnutzen
</span>
</$list>

<$list
    filter="[<recommendationScore>compare:number:gteq[40]compare:number:lt[70]]"
    variable="null"
>
<span class="cypro-catalog-gap-badge cypro-catalog-gap-yellow">
Sinnvolle Ergänzung
</span>
</$list>

<$list filter="[<recommendationScore>compare:number:gteq[70]]" variable="null">
<span class="cypro-catalog-gap-badge cypro-catalog-gap-green">
Optional ergänzend
</span>
</$list>

</$list>

</$let>
</$let>
</$let>
</$let>

\end

\define render-catalog-card()

<$let
    catalogId={{{ [<catalogItem>get[catalog-id]] }}}
    existingMeasure={{{ [tag[measure]field:catalog-id<catalogId>sort[id]first[]] }}}
>

<div class="cypro-measure-catalog-card">

<div class="cypro-measure-catalog-meta">

<span class="cypro-function-chip">
<$view tiddler=<<catalogItem>> field="control-label"/>
</span>

<span>
Rang <$view tiddler=<<catalogItem>> field="rank"/>
</span>

<<cypro-catalog-gap-badge>>

</div>

<h4>
<$view tiddler=<<catalogItem>> field="caption"/>
</h4>

<$list filter="[<catalogItem>get[text]minlength[1]]" variable="desc">
<div>

<$text text=<<desc>>/>
</div>
</$list>

<div class="cypro-measure-catalog-meta">

<$list filter="[<catalogItem>get[source-refs]minlength[1]]" variable="refs">
<span>KRT: <$text text=<<refs>>/></span>
</$list>
</div>

<$list filter="[<existingMeasure>is[blank]]" variable="null">
<$button class="cypro-btn cypro-btn-primary">

<$action-setfield
    $tiddler=<<catalogState>>
    text="yes"
/>

<$macrocall
    $name="cypro-add-catalog-measure"
    catalog=<<catalogItem>>
    threat=<<currentTag>>
/>

<span class="cypro-btn-label">Maßnahme hinzufügen</span>

</$button>
</$list>

<$list filter="[<existingMeasure>!is[blank]]" variable="null">

<$list filter="[<existingMeasure>tag<currentTag>]" variable="null">
<span class="cypro-measure-status-badge cypro-status-implemented">
Bereits zugeordnet
</span>
</$list>

<$list filter="[<existingMeasure>!tag<currentTag>]" variable="null">
<$button class="cypro-btn cypro-btn-primary">

<$action-setfield
    $tiddler=<<catalogState>>
    text="yes"
/>

<$macrocall
    $name="cypro-add-catalog-measure"
    catalog=<<catalogItem>>
    threat=<<currentTag>>
/>

<span class="cypro-btn-label">Vorhandene Maßnahme zuordnen</span>

</$button>
</$list>

</$list>

</div>

</$let>

\end

\define cypro-create-custom-measure()

<$let
    customCaption={{{ [<customTitleState>get[text]else[]] }}}
    customFunction={{{ [<customFunctionState>get[text]else[]] }}}
    customLabel={{{ [<customFunctionState>get[label]else[]] }}}
    newTitle={{{ [function[cypro-next-id],[measure],[M]] }}}
    newTags={{{ [[measure]] [<currentTag>] +[join[ ]] }}}
>

<$list
    filter="[<customCaption>minlength[1]] [<customFunction>minlength[1]] +[count[]match[2]]"
    variable="null"
>

<$action-createtiddler
    $basetitle=<<newTitle>>
    id=<<newTitle>>
    caption=<<customCaption>>
    tags=<<newTags>>
    control-function=<<customFunction>>
    control-label=<<customLabel>>
    source-catalog="custom"
/>

<$action-setfield
    $tiddler=<<newTitle>>
    $field=<<statusField>>
    $value="not-implemented"
/>

<$action-setfield $tiddler=<<customTitleState>> text=""/>

<$action-setfield
    $tiddler=<<customFunctionState>>
    text=""
    label=""
/>

<$action-setfield
    $tiddler=<<currentTag>>
    package_impact=""
    package_probability=""
/>

<$macrocall $name="update-risk-actions" threat=<<currentTag>>/>

</$list>

</$let>

\end

<$set name="isLocked" filter="[<cypro-lock-state>text[yes]]" value="yes" emptyValue="no">

<$set name="tv-action-refresh-policy" value="always">

<div class="kiks-body-area cypro-measures-section">

<div class="kiks-field-label cypro-measures-header">

Maßnahmen:</div>

<$let
    currentTag={{{ [<currentTiddler>get[title]] }}}
    threatNo={{{ [<currentTiddler>get[threat_no]search-replace:g[ ],[]] }}}
    statusField={{{ [<currentTiddler>get[title]addsuffix[_STATUS]] }}}
    searchState={{{ [[$:/temp/cypro/measure-search/]addsuffix<currentTiddler>] }}}
    catalogState={{{ [[$:/state/cypro/measure-catalog/]addsuffix<currentTiddler>] }}}
    moreState={{{ [[$:/state/cypro/measure-more/]addsuffix<currentTiddler>] }}}
    customTitleState={{{ [[$:/temp/cypro/custom-measure-title/]addsuffix<currentTiddler>] }}}
    customFunctionState={{{ [[$:/temp/cypro/custom-measure-function/]addsuffix<currentTiddler>] }}}

    implementedCount={{{ [tag[measure]tag<currentTag>] :filter[get<statusField>match[implemented]] +[count[]] }}}
    plannedCount={{{ [tag[measure]tag<currentTag>] :filter[get<statusField>match[planned]] +[count[]] }}}
    notImplementedCount={{{ [tag[measure]tag<currentTag>] :filter[get<statusField>match[not-implemented]] +[count[]] }}}
    financialCount={{{ [tag[measure]tag<currentTag>] :filter[get<statusField>match[financially-not-possible]] +[count[]] }}}
>

<div class="cypro-measure-workflow-step cypro-measure-workflow-step-selection">

<div class="cypro-measure-workflow-heading">

<span class="cypro-measure-workflow-number">1</span>
<div>

<h3>Maßnahmen auswählen</h3>
<p>
Wählen Sie zunächst passende Maßnahmen aus dem Katalog aus oder ergänzen Sie
eine eigene Maßnahme. Ausgewählte Maßnahmen werden anschließend im
Maßnahmenpaket bewertet.
</p>
</div>
</div>

<$list filter="[<currentTiddler>field:applicable[yes]]" variable="null">

<$list filter="[<isLocked>!match[yes]]" variable="ignore">

<div class="cypro-measure-catalog-toggle">

<$button class="cypro-btn cypro-btn-secondary" aria-expanded={{{ [<catalogState>get[text]match[yes]then[true]else[false]] }}}>
<$action-setfield
    $tiddler=<<catalogState>>
    text={{{ [<catalogState>get[text]match[yes]then[]else[yes]] }}}
/>
<span class="cypro-btn-label"><$text text={{{ [<catalogState>get[text]match[yes]then[Maßnahmenvorschläge schließen]else[Maßnahmenvorschläge anzeigen]] }}}/></span>
</$button>
</div>

<$list filter="[<catalogState>get[text]match[yes]]" variable="null">

<div class="cypro-measure-catalog">

<h3>Maßnahmenvorschläge</h3>

<p>
Zunächst wird je ein Vorschlag aus Prävention, Erkennung, Reaktion und
Wiederherstellung / Resilienz angezeigt.
</p>

<div class="cypro-measure-catalog-grid">

<$list
    filter="[tag[cypro-measure-catalog]field:threat-no<threatNo>field:control-function[prevention]sort[rank]first[]]"
    variable="catalogItem"
>
<<render-catalog-card>>
</$list>

<$list
    filter="[tag[cypro-measure-catalog]field:threat-no<threatNo>field:control-function[detection]sort[rank]first[]]"
    variable="catalogItem"
>
<<render-catalog-card>>
</$list>

<$list
    filter="[tag[cypro-measure-catalog]field:threat-no<threatNo>field:control-function[response]sort[rank]first[]]"
    variable="catalogItem"
>
<<render-catalog-card>>
</$list>

<$list
    filter="[tag[cypro-measure-catalog]field:threat-no<threatNo>field:control-function[recovery]sort[rank]first[]]"
    variable="catalogItem"
>
<<render-catalog-card>>
</$list>

</div>

<div class="cypro-more-measures">

<$button class="cypro-btn cypro-btn-secondary cypro-more-measures-toggle" aria-expanded={{{ [<moreState>get[text]match[yes]then[true]else[false]] }}}>
<$action-setfield
    $tiddler=<<moreState>>
    text={{{ [<moreState>get[text]match[yes]then[]else[yes]] }}}
/>
<span class="cypro-btn-label"><$text text={{{ [<moreState>get[text]match[yes]then[Weitere Vorschläge ausblenden]else[Weitere Maßnahmenvorschläge]] }}}/></span>
</$button>

<$list filter="[<moreState>get[text]match[yes]]" variable="null">

<div class="cypro-table-wrap" tabindex="0" role="region" aria-label="Weitere Maßnahmenvorschläge">

<div class="cypro-catalog-grid-table" role="table" aria-label="Weitere Maßnahmenvorschläge">

<div class="cypro-catalog-grid-header" role="row">

<div role="columnheader">

Rang</div>
<div role="columnheader">

Kategorie</div>
<div role="columnheader">

Maßnahme</div>
<div role="columnheader">

KRT-Referenz</div>
<div role="columnheader">

Aktion</div>
</div>

<div class="cypro-catalog-grid-body" role="rowgroup">

<$list
    filter="[tag[cypro-measure-catalog]field:threat-no<threatNo>nsort[rank]]"
    variable="catalogItem"
>

<$let
    catalogId={{{ [<catalogItem>get[catalog-id]] }}}
    existingMeasure={{{ [tag[measure]field:catalog-id<catalogId>sort[id]first[]] }}}
    catalogCaption={{{ [<catalogItem>get[caption]else<catalogItem>] }}}
>

<div class="cypro-catalog-grid-row" role="row">

<div class="cypro-catalog-grid-cell cypro-catalog-grid-rank" role="cell">

<$view tiddler=<<catalogItem>> field="rank"/>
</div>

<div class="cypro-catalog-grid-cell cypro-catalog-grid-category" role="cell">

<div class="cypro-catalog-category-stack">

<strong><$view tiddler=<<catalogItem>> field="control-label"/></strong>

<div class="cypro-catalog-table-gap">

<<cypro-catalog-gap-badge>>
</div>
</div>

</div>

<div class="cypro-catalog-grid-cell cypro-catalog-grid-measure" role="cell">

<strong><$text text=<<catalogCaption>>/></strong>

<$list filter="[<catalogItem>get[text]minlength[1]]" variable="desc">
<div class="cypro-measure-catalog-meta">

<$text text=<<desc>>/>
</div>
</$list>

</div>

<div class="cypro-catalog-grid-cell cypro-catalog-grid-reference" role="cell">

<$list
    filter="[<catalogItem>get[source-refs]minlength[1]]"
    variable="refs"
    emptyMessage="<span class='muted'>–</span>"
>
<$text text=<<refs>>/>
</$list>

</div>

<div class="cypro-catalog-grid-cell cypro-catalog-grid-action" role="cell">

<$list filter="[<existingMeasure>is[blank]]" variable="null">

<$button class="cypro-btn cypro-btn-primary">

<$action-setfield
    $tiddler=<<catalogState>>
    text="yes"
/>

<$action-setfield
    $tiddler=<<moreState>>
    text="yes"
/>

<$macrocall
    $name="cypro-add-catalog-measure"
    catalog=<<catalogItem>>
    threat=<<currentTag>>
/>

<span class="cypro-btn-label">Maßnahme hinzufügen</span>

</$button>

</$list>


<$list filter="[<existingMeasure>!is[blank]]" variable="null">

<$list filter="[<existingMeasure>tag<currentTag>]" variable="null">
<span class="cypro-measure-status-badge cypro-status-implemented">
Zugeordnet
</span>
</$list>

<$list filter="[<existingMeasure>!tag<currentTag>]" variable="null">

<$button class="cypro-btn cypro-btn-primary">

<$action-setfield
    $tiddler=<<catalogState>>
    text="yes"
/>

<$action-setfield
    $tiddler=<<moreState>>
    text="yes"
/>

<$macrocall
    $name="cypro-add-catalog-measure"
    catalog=<<catalogItem>>
    threat=<<currentTag>>
/>

<span class="cypro-btn-label">Maßnahme zuordnen</span>

</$button>

</$list>

</$list>

</div>

</div>

</$let>

</$list>

</div>

</div>

</div>

</$list>

</div>

<div class="cypro-risk-disclaimer">

Maßnahmenvorschläge ersetzen keine unternehmensspezifische Prüfung von
Anwendbarkeit, Wirksamkeit und Verhältnismäßigkeit.
</div>

</div>

</$list>

<div class="cypro-existing-measure-search">

<h4>Vorhandene Maßnahme zuordnen</h4>

<div class="kiks-measure-search-wrapper">

<$edit-text
    tiddler=<<searchState>>
    field="text"
    placeholder="Vorhandene Maßnahme suchen..."
    class="kiks-measure-search-input cypro-field-input"
    tag="input"
/>

<$let searchText={{{ [<searchState>get[text]else[]] }}}>

<$list
    filter="[<searchText>length[]compare:number:gteq[1]]"
    variable="ignore"
>

<div class="kiks-measure-dropdown">

<$list
    filter="[tag[measure]!tag<currentTag>search:title,caption<searchText>sort[caption]limit[10]]"
    variable="result"
    emptyMessage="<div class='kiks-dropdown-empty'>Keine vorhandene Maßnahme gefunden.</div>"
>

<$let resultCaption={{{ [<result>get[caption]else<result>] }}}>

<div class="kiks-dropdown-item">

<$button class="kiks-dropdown-button">

<$action-listops
    $tiddler=<<result>>
    $tags="[<currentTag>]"
/>

<$action-setfield
    $tiddler=<<result>>
    $field=<<statusField>>
    $value="not-implemented"
/>

<$action-setfield
    $tiddler=<<currentTag>>
    package_impact=""
    package_probability=""
/>

<$action-setfield $tiddler=<<searchState>> text=""/>

<$macrocall $name="update-risk-actions" threat=<<currentTag>>/>

<$text text=<<resultCaption>>/>

</$button>

</div>

</$let>

</$list>

</div>

</$list>

</$let>

</div>

</div>

<div class="cypro-custom-measure-launch-panel">

<div>

<h4>Eigene Maßnahme</h4>
<p>
Ergänzen Sie eine unternehmensspezifische Maßnahme, wenn die Vorschläge
Ihren Bedarf nicht vollständig abdecken.
</p>
</div>

<$button class="cypro-btn cypro-btn-primary">

<$macrocall $name="cypro-open-measure-editor" measure="" threat=<<currentTag>>/>

<span class="cypro-btn-label">+ Eigene Maßnahme erstellen</span>

</$button>

</div>

</$list>

<$list filter="[<isLocked>match[yes]]" variable="ignore">

<div class="cypro-identification-note cypro-readonly-measure-note">

Im schreibgeschützten Modus können Maßnahmen und Status nur angesehen werden.
</div>

</$list>

</$list>

<$list filter="[<currentTiddler>field:applicable[no]]" variable="null">
<div class="cypro-identification-note">

Für eine nicht anwendbare Gefährdung wird kein Maßnahmenpaket aufgebaut.
</div>
</$list>

</div>

<$list filter="[<currentTiddler>field:applicable[yes]]" variable="null">

<div class="cypro-measure-workflow-step cypro-measure-workflow-step-package">

<div class="cypro-measure-workflow-heading">

<span class="cypro-measure-workflow-number">2</span>
<div>

<h3>Maßnahmenpaket</h3>
<p>
Legen Sie für jede ausgewählte Maßnahme den aktuellen Umsetzungsstatus fest.
Nur Maßnahmen mit Status „Umgesetzt“ wirken auf die anschließende
Restrisikobewertung.
</p>
</div>
</div>

<div class="cypro-package-status-counts cypro-package-status-counts-wide">

<span><strong><$text text=<<implementedCount>>/></strong> umgesetzt</span>
<span><strong><$text text=<<plannedCount>>/></strong> in Planung</span>
<span><strong><$text text=<<notImplementedCount>>/></strong> nicht umgesetzt</span>
<span><strong><$text text=<<financialCount>>/></strong> finanziell nicht möglich</span>
</div>

<$list
    filter="[tag[measure]tag<currentTag>limit[1]]"
    emptyMessage="<div class='cypro-package-awaiting'>Noch keine Maßnahme ausgewählt. Wählen Sie im ersten Schritt mindestens eine Maßnahme aus.</div>"
    variable="null"
>

<div class="cypro-table-wrap cypro-package-table-wrap" tabindex="0" role="region" aria-label="Maßnahmenpaket">

<div class="cypro-package-grid-table" role="table" aria-label="Maßnahmenpaket">

<div class="cypro-package-grid-header" role="row">

<div role="columnheader">

Maßnahme</div>
<div role="columnheader">

Kategorie</div>
<div role="columnheader">

Status</div>
<div role="columnheader">

Bearbeitung</div>
<div role="columnheader">

<span class="cypro-remove-heading" title="Maßnahme entfernen">✖</span></div>
</div>

<div class="cypro-package-grid-body" role="rowgroup">

<$list filter="[tag[measure]tag<currentTag>sort[id]]" variable="measureTiddler">

<$let
    measureCaption={{{ [<measureTiddler>get[caption]else<measureTiddler>] }}}
    isCustom={{{ [<measureTiddler>has[catalog-id]then[no]else[yes]] }}}
>

<div class="cypro-package-grid-row" role="row">

<div class="cypro-package-grid-cell cypro-package-grid-measure" role="cell">

<div class="cypro-measure-title-stack">

<strong><$text text=<<measureCaption>>/></strong>

<$list filter="[<isCustom>match[yes]]" variable="null">
<span class="cypro-custom-measure-badge">Eigene Maßnahme</span>
</$list>

<$list filter="[<measureTiddler>get[text]minlength[1]]" variable="measureText">
<div class="cypro-measure-preview">

<$text text=<<measureText>>/>
</div>
</$list>

</div>
</div>

<div class="cypro-package-grid-cell cypro-package-grid-category" role="cell">

<span class="cypro-function-chip">
<$view
    tiddler=<<measureTiddler>>
    field="control-label"
    emptyValue="Ohne Kategorie"
/>
</span>
</div>

<div class="cypro-package-grid-cell cypro-package-grid-status" role="cell">

<$list filter="[<isLocked>match[yes]]" variable="ignore">
<<render-measure-status>>
</$list>

<$list filter="[<isLocked>!match[yes]]" variable="ignore">
<<render-measure-status-options>>
</$list>

</div>

<div class="cypro-package-grid-cell cypro-package-grid-action" role="cell">

<$list filter="[<isLocked>!match[yes]]" variable="ignore">

<$button class="cypro-btn cypro-btn-secondary">
<$macrocall $name="cypro-open-measure-editor" measure=<<measureTiddler>> threat=<<currentTag>>/>
<span class="cypro-btn-label">Bearbeiten</span>
</$button>

</$list>

<span class="cypro-measure-origin-badge"><$text text={{{ [<isCustom>match[yes]then[Manuell]else[Katalog]] }}}/></span>

</div>

<div class="cypro-package-grid-cell cypro-package-grid-remove" role="cell">

<$list filter="[<isLocked>!match[yes]]" variable="ignore">

<$button
    class="kiks-remove-button"
    tooltip="Maßnahme aus diesem Paket entfernen"
    aria-label="Maßnahme aus diesem Paket entfernen"
>

<$set name="tv-action-refresh-policy" value="always">

<$action-listops
    $tiddler=<<measureTiddler>>
    $tags="-[<currentTag>]"
/>

<$action-deletefield
    $tiddler=<<measureTiddler>>
    $field=<<statusField>>
/>

<$action-setfield
    $tiddler=<<currentTag>>
    package_impact=""
    package_probability=""
/>

<$macrocall
    $name="update-risk-actions"
    threat=<<currentTag>>
/>

</$set>

✖

</$button>

</$list>

</div>

</div>

</$let>

</$list>

</div>

</div>

</div>

<div class="cypro-package-coverage">

<strong>Abdeckung der Funktionsbereiche</strong>

<div class="cypro-coverage-grid">

<<coverage-chip "prevention" "Prävention">>
<<coverage-chip "detection" "Erkennung">>
<<coverage-chip "response" "Reaktion">>
<<coverage-chip "recovery" "Wiederherstellung / Resilienz">>
</div>

</div>

</$list>

</div>

</$list>

<$list
    filter="[<currentTiddler>field:applicable[yes]has[initial_impact]has[initial_probability]]"
    variable="null"
>

<div class="cypro-measure-workflow-step cypro-measure-workflow-step-result">

<div class="cypro-measure-workflow-heading">

<span class="cypro-measure-workflow-number">3</span>
<div>

<h3>Restrisiko neu bewerten</h3>
<p>
Bewerten Sie Schadenshöhe und Eintrittshäufigkeit erneut auf Basis der
tatsächlich umgesetzten Maßnahmen.
</p>
</div>
</div>

<$list filter="[<implementedCount>compare:number:gt[0]]" variable="null">

<div class="cypro-package-reassessment">

<h4>Restrisiko nach dem umgesetzten Maßnahmenpaket neu bewerten</h4>

<p>
Bewerten Sie Schadenshöhe und Eintrittshäufigkeit erneut unter Berücksichtigung
der tatsächlich umgesetzten Maßnahmen. Maßnahmen mit Status „In Planung“
werden hier noch nicht berücksichtigt.
</p>

<div class="cypro-package-scales">

<div class="cypro-package-scale-slot">

<<package-impact-scale>>

</div>

<div class="cypro-package-scale-slot">

<<package-probability-scale>>

</div>

</div>

<div class="cypro-package-risk-result">

<div>

<span>Initiales Risiko</span>
<strong><$macrocall $name="cypro-risk-badge" value={{{ [<currentTiddler>get[initial_risk]] }}}/></strong>
</div>

<div class="cypro-package-arrow">

→</div>

<div>

<span>Restrisiko</span>
<strong><$macrocall $name="cypro-risk-badge" value={{{ [<currentTiddler>get[final_risk]] }}}/></strong>
</div>

</div>

<$list
    filter="[<currentTiddler>has[package_impact]has[package_probability]]"
    variable="null"
    emptyMessage="<div class='cypro-identification-note cypro-package-reassessment-pending'>Die erneute Bewertung des umgesetzten Maßnahmenpakets ist noch offen.</div>"
>
<div class="cypro-package-reassessment-complete">

Neubewertung des umgesetzten Maßnahmenpakets erfasst.
</div>
</$list>

</div>

</$list>

<$list filter="[<implementedCount>compare:number:eq[0]]" variable="null">

<div class="cypro-package-awaiting">

Eine erneute Restrisikobewertung wird freigeschaltet, sobald mindestens eine
Maßnahme den Status „Umgesetzt“ hat. Maßnahmen in Planung verändern das
aktuelle Restrisiko nicht.
</div>

</$list>

</div>

<div class="cypro-measure-workflow-step cypro-measure-workflow-step-protection">

<div class="cypro-measure-workflow-heading">

<span class="cypro-measure-workflow-number">4</span>
<div>

<h3>Schutzgrad</h3>
<p>Der Schutzgrad zeigt die Breite und den Umsetzungsstand Ihres Maßnahmenpakets.</p>
</div>
</div>

<<cypro-protection-gauge>>

</div>

</$list>

<$list
    filter="[<currentTiddler>field:applicable[yes]] -[<currentTiddler>has[initial_impact]has[initial_probability]]"
    variable="null"
>

<div class="cypro-measure-workflow-step cypro-measure-workflow-step-result">

<div class="cypro-measure-workflow-heading">

<span class="cypro-measure-workflow-number">3</span>
<div>

<h3>Restrisiko neu bewerten</h3>
<p>
Die Maßnahmen können bereits ausgewählt und zu einem Paket zusammengestellt
werden. Für die Restrisikobewertung muss zunächst die Ausgangsbewertung der
Gefährdung abgeschlossen werden.
</p>
</div>
</div>

<div class="cypro-package-awaiting">

Bewerten Sie zunächst Schadenshöhe und Eintrittshäufigkeit der Gefährdung.
Danach wird die Restrisikobewertung freigeschaltet.
</div>

</div>

<div class="cypro-measure-workflow-step cypro-measure-workflow-step-protection">

<div class="cypro-measure-workflow-heading">

<span class="cypro-measure-workflow-number">4</span>
<div>

<h3>Schutzgrad</h3>
<p>Der Schutzgrad zeigt die Breite und den Umsetzungsstand Ihres Maßnahmenpakets.</p>
</div>
</div>
<div class="cypro-package-awaiting">

Der Schutzgrad wird nach der abgeschlossenen Ausgangsbewertung angezeigt.
</div>
</div>

</$list>

</$let>

</div>

</$set>
</$set>
