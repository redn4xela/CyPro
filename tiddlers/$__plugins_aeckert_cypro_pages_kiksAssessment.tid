<!-- Create a KIKS and all standard threats. -->
\define cypro-complete-kiks()

<$list
    filter="[<assessment-draft>field:confirmed-type[system]field:system-protection[data]]"
    variable="null"
>

<$action-setfield
    $tiddler=<<selectedInventory>>
    object-type="system"
    system-protection="data"
    impact="yes"
    influence={{$:/temp/cypro/kiks-assessment!!influence}}
    german-jurisdiction="yes"
    jurisdiction-reason={{$:/temp/cypro/kiks-assessment!!jurisdiction-reason}}
    assessment-status="completed"
    assessment-result="kiks"
    assessment-reason=""
/>

</$list>


<$list
    filter="[<assessment-draft>field:confirmed-type[data]] [<assessment-draft>field:confirmed-type[system]field:system-protection[system]]"
    variable="null"
>

<$action-setfield
    $tiddler=<<selectedInventory>>
    object-type={{$:/temp/cypro/kiks-assessment!!confirmed-type}}
    system-protection={{$:/temp/cypro/kiks-assessment!!system-protection}}
    impact="yes"
    influence={{$:/temp/cypro/kiks-assessment!!influence}}
    german-jurisdiction="yes"
    jurisdiction-reason={{$:/temp/cypro/kiks-assessment!!jurisdiction-reason}}
    assessment-status="completed"
    assessment-result="kiks"
    assessment-reason=""
/>

</$list>


<$vars
    maxNum={{{ [tag[KIKS]!has[draft.of]each[title]get[title]removeprefix[K]nsort[]last[]] ~[[00]] }}}
>

<$vars
    nextID={{{ [<maxNum>add[1]pad[2]addprefix[K]] }}}
>


<!-- Create all default threats. -->
<$list
    filter="[[$:/plugins/aeckert/cypro/data/default-threats]indexes[]suffix[.caption]removesuffix[.caption]]"
    variable="suffix"
>

<$let
    threatTitle={{{ [<nextID>addsuffix<suffix>] }}}
    threat_no={{{ [<suffix>addsuffix[.threat_no]] }}}
    threat_caption={{{ [<suffix>addsuffix[.caption]] }}}
>

<$action-createtiddler
    $basetitle=<<threatTitle>>
    tags="threat"
    id=<<threatTitle>>
    kiks=<<nextID>>
    threat_no={{{ [[$:/plugins/aeckert/cypro/data/default-threats]getindex<threat_no>] }}}
    caption={{{ [[$:/plugins/aeckert/cypro/data/default-threats]getindex<threat_caption>] }}}
    mandatory="yes"
    initial_impact=""
    initial_probability=""
    final_probability=""
    final_impact=""
    final_risk=""
    applicable=""
    text=""
/>

</$let>

</$list>

<$let
    effectiveType={{{ 
        [<assessment-draft>field:confirmed-type[data]then[data]]
        [<assessment-draft>field:confirmed-type[system]field:system-protection[data]then[data]]
        [<assessment-draft>field:confirmed-type[system]field:system-protection[system]then[system]]
    }}}
>
<!-- Create the KIKS itself. -->
<$action-createtiddler
    $basetitle=<<nextID>>
    tags="KIKS"
    id=<<nextID>>
    caption={{{ [<selectedInventory>get[caption]] }}}
    kiks=<<effectiveType>>
    influence={{$:/temp/cypro/kiks-assessment!!influence}}
    aviation-security-tasks={{{ [<selectedInventory>get[aviation-security-tasks]] }}}
    aviation-security-cargo-tasks={{{ [<selectedInventory>get[aviation-security-cargo-tasks]] }}}
    aviation-security-task-other={{{ [<selectedInventory>get[aviation-security-task-other]] }}}
    aviation-security-task-none={{{ [<selectedInventory>get[aviation-security-task-none]] }}}
    identification-impact="yes"
    identification-german-jurisdiction="yes"
    identification-jurisdiction-reason={{$:/temp/cypro/kiks-assessment!!jurisdiction-reason}}
    identification-system-protection={{$:/temp/cypro/kiks-assessment!!system-protection}}
    identification-source=<<selectedInventory>>
    text=""
>

<$action-setfield
    $tiddler=<<selectedInventory>>
    linked-kiks=<<createTiddler-title>>
/>


<!-- Continue with the next inventory entry. -->
<$list
    filter="[<after-create-state>get[text]match[inventory]]"
    variable="null"
>

<$action-setfield
    $tiddler=<<assessment-selection>>
    text=""
/>

<<cypro-clear-assessment>>

<$action-setfield
    $tiddler=<<after-create-state>>
    text=""
/>

<$action-navigate
    $to="$:/plugins/aeckert/cypro/pages/inventory"
/>

</$list>


<!-- Continue directly with the newly created KIKS. -->
<$list
    filter="[<after-create-state>get[text]match[kiks]]"
    variable="null"
>

<$action-setfield
    $tiddler={{{ [<createTiddler-title>addprefix[$:/state/cypro/edit-title/]] }}}
    text="yes"
/>

<$action-setfield
    $tiddler=<<assessment-selection>>
    text=""
/>

<<cypro-clear-assessment>>

<$action-setfield
    $tiddler=<<after-create-state>>
    text=""
/>

<$action-navigate
    $to=<<createTiddler-title>>
/>

</$list>

</$action-createtiddler>
</$let>
</$vars>
</$vars>

\end


<!-- Create the KIKS and return to the inventory. -->
\define cypro-complete-kiks-to-inventory()

<$action-setfield
    $tiddler=<<after-create-state>>
    text="inventory"
/>

<<cypro-complete-kiks>>

\end


<!-- Create the KIKS and continue with its threat assessment. -->
\define cypro-complete-kiks-to-kiks()

<$action-setfield
    $tiddler=<<after-create-state>>
    text="kiks"
/>

<<cypro-complete-kiks>>

\end


<style>
.cypro-assessment {
    max-width: 900px;
    line-height: 1.5;
}

.cypro-assessment * {
    box-sizing: border-box;
}

.cypro-assessment-card {
    border: 1px solid #d7dce2;
    border-radius: 8px;
    padding: 1.2em;
    margin: 1em 0;
    background: #fff;
}

.cypro-assessment-card h2 {
    margin-top: 0;
    font-size: 1.15em;
}

.cypro-assessment-summary {
    background: #f4f7fa;
    border-left: 4px solid #99a9ba;
    padding: 0.8em 1em;
    margin: 1em 0;
}

.cypro-assessment-options {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2em;
    margin: 0.8em 0;
}

.cypro-assessment-options label {
    display: inline-flex;
    gap: 0.4em;
    align-items: center;
}

.cypro-assessment-textarea {
    width: 100%;
    min-height: 90px;
    padding: 0.65em;
    border: 1px solid #c8cdd3;
    border-radius: 5px;
    font: inherit;
}

.cypro-assessment-info {
    margin: 0.8em 0;
    padding: 0.8em;
    border: 1px solid #bed4ed;
    border-radius: 6px;
    background: #eef5fd;
}

.cypro-assessment-info summary {
    cursor: pointer;
    font-weight: bold;
}

.cypro-assessment-result {
    padding: 1em;
    margin: 1em 0;
    border-radius: 7px;
}

.cypro-assessment-result-kiks {
    background: #fdeaea;
    border: 1px solid #d99494;
    color: #7c1f1f;
}

.cypro-assessment-result-nonkiks {
    background: #e9f7ed;
    border: 1px solid #8fc49e;
    color: #205f32;
}

.cypro-assessment-hint {
    color: #68727d;
    font-size: 0.9em;
    margin: 0.7em 0;
}

.cypro-assessment-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7em;
    margin-top: 1em;
}
.cypro-assessment-task-box {
    margin-top: 0.8em;
    padding: 0.7em 0.9em;
    background: #fff;
    border: 1px solid #d7e0e8;
    border-radius: 6px;
}

.cypro-assessment-task-item {
    margin: 0.2em 0;
}

.cypro-assessment-task-subitem {
    margin: 0.15em 0 0.15em 1.2em;
    color: #56616d;
    font-size: 0.92em;
}
</style>


