\define render-aviation-tasks(sourceTiddler)

<!-- Show the explicit "none" selection. -->
<$list
    filter="[[$sourceTiddler$]get[aviation-security-task-none]match[yes]]"
    variable="null"
>
<div class="cypro-assessment-task-item">
Keine Luftsicherheitsaufgabe
</div>
</$list>


<!-- Render all selected aviation security tasks. -->
<$list
    filter="[[$sourceTiddler$]get[aviation-security-tasks]enlist-input[]]"
    variable="task"
>

<div class="cypro-assessment-task-item">

<$list filter="[<task>match[access-control]]" variable="null">
• Zugangssicherung
</$list>

<$list filter="[<task>match[passenger-baggage-screening]]" variable="null">
• Personen- und Gepäckkontrollen
</$list>

<$list filter="[<task>match[air-cargo-security]]" variable="null">
• Luftfrachtsicherheit
</$list>

<$list filter="[<task>match[personnel-screening]]" variable="null">
• Personalüberprüfung
</$list>

<$list filter="[<task>match[surveillance-interference-protection]]" variable="null">
• Überwachung und Schutz vor unbefugtem Eingreifen
</$list>

<$list filter="[<task>match[training-records]]" variable="null">
• Schulungsnachweise
</$list>

<$list filter="[<task>match[security-programmes]]" variable="null">
• Sicherheitsprogramme
</$list>

<$list filter="[<task>match[other]]" variable="null">
• Sonstige
<$list
    filter="[[$sourceTiddler$]get[aviation-security-task-other]minlength[1]]"
    variable="otherText"
>
: <$text text=<<otherText>>/>
</$list>
</$list>

</div>


<!-- Render cargo-specific subcategories. -->
<$list
    filter="[<task>match[air-cargo-security]]"
    variable="null"
>

<$list
    filter="[[$sourceTiddler$]get[aviation-security-cargo-tasks]enlist-input[]]"
    variable="cargoTask"
>

<div class="cypro-assessment-task-subitem">

<$list filter="[<cargoTask>match[cargo-unauthorised-interference]]" variable="null">
– Schutz vor unbefugtem Eingreifen
</$list>

<$list filter="[<cargoTask>match[cargo-secure-supply-chain]]" variable="null">
– Sicherheit innerhalb der sicheren Lieferkette
</$list>

<$list filter="[<cargoTask>match[cargo-shipment-status]]" variable="null">
– Sendungsstatus
</$list>

</div>

</$list>

</$list>

</$list>


<!-- Show a hint for legacy entries without an assignment. -->
<$list
    filter="[[$sourceTiddler$]get[aviation-security-task-none]!match[yes]]"
    variable="null"
>
<$list
    filter="[[$sourceTiddler$]get[aviation-security-tasks]enlist-input[]count[]match[0]]"
    variable="null"
>
<div class="cypro-assessment-task-item">
Noch keine Luftsicherheitsaufgabe zugeordnet
</div>
</$list>
</$list>

\end

<!-- Clear the temporary assessment values. -->
\define cypro-clear-assessment()

<$action-setfield
    $tiddler=<<assessment-draft>>
    caption=""
    original-type=""
    confirmed-type=""
    system-protection=""
    impact=""
    influence=""
    german-jurisdiction=""
    jurisdiction-reason=""
/>

\end


<!-- Clear values that depend on the confirmed type. -->
\define cypro-reset-after-type()

<$action-setfield
    $tiddler=<<assessment-draft>>
    system-protection=""
    impact=""
    influence=""
    german-jurisdiction=""
    jurisdiction-reason=""
/>

\end


<!-- Clear values that depend on the system protection decision. -->
\define cypro-reset-after-protection()

<$action-setfield
    $tiddler=<<assessment-draft>>
    impact=""
    influence=""
    german-jurisdiction=""
    jurisdiction-reason=""
/>

\end


<!-- Complete an assessment where only the data on a system is relevant. -->
\define cypro-complete-data-only()

<$action-setfield
    $tiddler=<<selectedInventory>>
    object-type={{$:/temp/cypro/kiks-assessment!!confirmed-type}}
    system-protection="data"
    impact=""
    influence=""
    german-jurisdiction=""
    jurisdiction-reason=""
    assessment-status="completed"
    assessment-result="non-kiks"
    assessment-reason="system-data-only"
/>

<$action-setfield
    $tiddler=<<assessment-selection>>
    text=""
/>

<<cypro-clear-assessment>>

<$action-navigate
    $to="$:/plugins/aeckert/cypro/pages/inventory"
/>

\end


<!-- Complete an assessment with no aviation-security impact. -->
