    jurisdiction-reason=""
    assessment-status="completed"
    assessment-result="non-kiks"
    assessment-reason="no-aviation-impact"
/>

</$list>

<$action-setfield
    $tiddler=<<assessment-selection>>
    text=""
/>

<<cypro-clear-assessment>>

<$action-navigate
    $to="$:/plugins/aeckert/cypro/pages/inventory"
/>

\end


<!-- Complete an assessment without German jurisdiction. -->
\define cypro-complete-no-jurisdiction()

