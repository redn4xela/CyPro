\define kiks-create-action(identificationMethod:"")
<!--
  kiks-create-action — create a new KIKS entry plus its default catalog threats.

  A KIKS ("Kritische Infrastruktur-Komponente / Schutzobjekt") is the central
  data entity. Each one is a tiddler tagged `KIKS` with an id like "K01", "K02".

  The optional identificationMethod parameter stores how the KIKS was identified.
  It is currently used for manual KIKS creation. Existing callers may omit it.

  Steps:
    1. Find the highest existing KIKS number and derive the next id.
    2. Seed the standard set of threats from the catalog.
    3. Create the KIKS itself and navigate to it.
-->

<!-- Use the shared central KIKS id helper. -->
<$vars nextID={{{ [function[cypro-next-id],[KIKS],[K]] }}}>

<!-- Create the default threats from the catalog. -->
<$list
  filter="[[$:/plugins/aeckert/cypro/data/default-threats]indexes[]suffix[.caption]removesuffix[.caption]]"
  variable="suffix"
>
  <$let
    threatTitle={{{ [<nextID>addsuffix<suffix>] }}}
    threat_no={{{ [<suffix>addsuffix[.threat_no]] }}}
    threat_caption={{{ [<suffix>addsuffix[.caption]] }}}
  >
    <$action-createtiddler
      $basetitle=<<threatTitle>>
      tags="threat"
      id=<<threatTitle>>
      kiks=<<nextID>>
      threat_no={{{ [[$:/plugins/aeckert/cypro/data/default-threats]getindex<threat_no>] }}}
      caption={{{ [[$:/plugins/aeckert/cypro/data/default-threats]getindex<threat_caption>] }}}
      mandatory="yes"
      initial_impact=""
      initial_probability=""
      final_probability=""
      final_impact=""
      final_risk=""
      applicable=""
      text=""
    />
  </$let>
</$list>

<!-- Create the KIKS itself. -->
<$action-createtiddler
  $basetitle=<<nextID>>
  tags="KIKS"
  caption=""
  id=<<nextID>>
  identification-method="$identificationMethod$"
  text=""
>
  <$action-navigate $to=<<createTiddler-title>>/>
</$action-createtiddler>

</$vars>
\end


\define kiks-create-manual-action()
<!-- Keep the manual path selected and mark the new KIKS accordingly. -->
<$action-setfield
    $tiddler="$:/cypro/data/kiksIdentificationFlow"
    method="manual"
/>

<<kiks-create-action "manual">>
\end
