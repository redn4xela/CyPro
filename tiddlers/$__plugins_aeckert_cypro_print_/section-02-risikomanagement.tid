!!! 2.3.1.1 Methodik

''Vorgehensweise zur Identifizierung von Gefährdungen:''<br>
{{$:/cypro/data/identificationRisk!!risk-method-text}}
{{$:/cypro/data/identificationRisk!!risk-method-additional}}

!!! 2.3.1.2 Auflistung Gefährdungen
<$list filter="[tag[KIKS]!prefix[Draft]sort[id]]">
<$set name="KIKS" value=<<currentTiddler>>>

''{{!!id}}: {{!!caption}}''

<$list filter="[tag[threat]kiks<KIKS>sort[threat_no]applicable[yes]] :filter[has[initial_impact]has[initial_probability]]" variable="threatTiddler">
<$let
  riField={{{ [<threatTiddler>get[title]addsuffix[_RI]] }}}
  rpField={{{ [<threatTiddler>get[title]addsuffix[_RP]] }}}
>

<div class="threat-block">
<table style="width:100%; border-collapse:collapse; margin-bottom:0.5em;">
  <thead>
    <tr style="background:#e8e8e8;">
      <th colspan="2" style="padding:4px 8px; text-align:left;">
        <$macrocall $name="cypro-threat-no-label" t=<<threatTiddler>>/> – 
        <$transclude tiddler=<<threatTiddler>> field="caption"/>
      </th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="width:40%; padding:4px 8px;">Anwendbarkeit</td>
      <td style="padding:4px 8px;">Ja</td>
    </tr>
    <$list filter="[<threatTiddler>has[protection_goal]]" variable="null">
    <tr>
      <td style="width:40%; padding:4px 8px;">Schutzziel</td>
      <td style="padding:4px 8px;"><$transclude tiddler=<<threatTiddler>> field="protection_goal"/></td>
    </tr>
    </$list>
    <tr>
      <td style="padding:4px 8px;">Eintrittshäufigkeit (initial)</td>
      <td style="padding:4px 8px;"><$transclude tiddler=<<threatTiddler>> field="initial_probability"/></td>
    </tr>
    <tr>
      <td style="padding:4px 8px;">Schadenshöhe (initial)</td>
      <td style="padding:4px 8px;"><$transclude tiddler=<<threatTiddler>> field="initial_impact"/></td>
    </tr>
    <tr>
      <td style="padding:4px 8px;"><strong>Initialer Risikowert</strong></td>
      <td style="padding:4px 8px;"><strong><$transclude tiddler=<<threatTiddler>> field="initial_risk"/></strong></td>
    </tr>

    <$list filter="[tag[measure]tag<threatTiddler>sort[title]]" variable="measureTiddler" counter="measureCounter">
      <$let
        riField={{{ [<threatTiddler>get[title]addsuffix[_RI]] }}}
        rpField={{{ [<threatTiddler>get[title]addsuffix[_RP]] }}}
      >
        <% if [<measureCounter>match[1]] %>
        <tr>
          <td colspan="2" style="padding:4px 8px; background:#f5f5f5;">
            <strong>Maßnahmen:</strong>
          </td>
        </tr>
        <% endif %>

        <tr>
          <td colspan="2" style="padding:0 8px 0 2em;">
            <table style="width:100%; border-collapse:collapse; border-left: 3px solid #ccc;">
              <tr style="background:#fafafa;">
                <td colspan="2" style="padding:4px 8px;">
                  <strong><$transclude tiddler=<<measureTiddler>> field="caption"/></strong>
                </td>
              </tr>
              <tr>
                <td style="width:40%; padding:4px 8px; padding-left:1.5em;">Beschreibung</td>
                <td style="padding:4px 8px;"><$transclude tiddler=<<measureTiddler>> field="text"/></td>
              </tr>
              <tr>
                <td style="padding:4px 8px; padding-left:1.5em;">Auswirkung auf Eintrittshäufigkeit</td>
                <td style="padding:4px 8px;"><$transclude tiddler=<<measureTiddler>> field=<<rpField>>/></td>
              </tr>
              <tr>
                <td style="padding:4px 8px; padding-left:1.5em;">Auswirkung auf Schadenshöhe</td>
                <td style="padding:4px 8px;"><$transclude tiddler=<<measureTiddler>> field=<<riField>>/></td>
              </tr>
            </table>
          </td>
        </tr>
      </$let>
    </$list>

    <tr>
      <td style="padding:4px 8px;"><strong>Finaler Risikowert</strong></td>
      <td style="padding:4px 8px;"><strong><$transclude tiddler=<<threatTiddler>> field="final_risk"/></strong></td>
    </tr>
  </tbody>
</table>
</div>
</$let>
</$list>

<$list filter="[tag[threat]kiks<KIKS>sort[threat_no]field:applicable[no]]" variable="threatTiddler">
<div class="threat-block">
<table style="width:100%; border-collapse:collapse; margin-bottom:0.5em;">
  <thead>
    <tr style="background:#e8e8e8;">
      <th colspan="2" style="padding:4px 8px; text-align:left;">
        <$macrocall $name="cypro-threat-no-label" t=<<threatTiddler>>/> – 
        <$transclude tiddler=<<threatTiddler>> field="caption"/>
      </th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="width:40%; padding:4px 8px;">Anwendbar</td>
      <td style="padding:4px 8px;">Nicht anwendbar</td>
    </tr>
    <$list filter="[<threatTiddler>has[protection_goal]]" variable="null">
    <tr>
      <td style="width:40%; padding:4px 8px;">Schutzziel</td>
      <td style="padding:4px 8px;"><$transclude tiddler=<<threatTiddler>> field="protection_goal"/></td>
    </tr>
    </$list>
  </tbody>
</table>
</div>
</$list>

<!-- TASK-127: threats without a determined risk — undecided applicability, or
     applicable but missing Schadenshöhe/Eintrittshäufigkeit — are flagged as
     "Nicht bewertet" instead of being mislabelled "Nicht anwendbar". The
     checks/threats-assessed check normally prevents printing this state. -->
<$list filter="[tag[threat]kiks<KIKS>sort[threat_no]!field:applicable[no]] -[has[initial_impact]has[initial_probability]]" variable="threatTiddler">
<div class="threat-block">
<table style="width:100%; border-collapse:collapse; margin-bottom:0.5em;">
  <thead>
    <tr style="background:#e8e8e8;">
      <th colspan="2" style="padding:4px 8px; text-align:left;">
        <$macrocall $name="cypro-threat-no-label" t=<<threatTiddler>>/> – 
        <$transclude tiddler=<<threatTiddler>> field="caption"/>
      </th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="width:40%; padding:4px 8px;">Anwendbarkeit</td>
      <td style="padding:4px 8px;">Nicht bewertet</td>
    </tr>
  </tbody>
</table>
</div>
</$list>

</$set>
</$list>

