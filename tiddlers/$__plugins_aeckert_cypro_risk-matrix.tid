\define cell-matches(row, col)
<!-- row = Schadenshöhe (final_impact), col = Eintrittshäufigkeit (final_probability) —
     must match the table's axis labels below (vertical=Schadenshöhe, horizontal=Eintrittshäufigkeit).
     TASK-127: only threats with a determined final risk are placed; unassessed threats
     (blank final_impact/final_probability) are excluded instead of defaulting to cell (1,1). -->
<$list filter="[tag[threat]field:applicable[yes]has[final_impact]has[final_probability]]" variable="threat">
	<$set name="p" value={{{ [<threat>get[final_probability]] }}}>
  <$set name="i" value={{{ [<threat>get[final_impact]] }}}>
		<%if [<i>compare:number:eq[$row$]] %>
			<%if [<p>compare:number:eq[$col$]] %>
				<<threat>>,
			<%endif%>
		<%endif%>
	</$set>
  </$set>	
</$list>
\end



\define cell(row, col)
<$wikify name="matches" text="""<$macrocall $name="cell-matches" row="$row$" col="$col$"/>""">
  <$let 
    count={{{ [<matches>trim[]split[,]!is[blank]count[]] }}}
		matchlist={{{ [<matches>trim[]split[,]!is[blank]] }}}
    value={{{ [[$row$]multiply[$col$]] }}}
  >
    <$list filter="[<count>compare:number:gt[0]]" variable="null">
      <$button class="risk-cell-button" actions=<<open-cell-details "$row$" "$col$">>>
        <div class="risk-value"><<value>></div>
      </$button>
      <span class="risk-badge"><<count>></span>
    </$list>
    <$list filter="[<count>compare:number:eq[0]]" variable="null">
      <div class="risk-cell-empty">
        <div class="risk-value-static"><<value>></div>
      </div>
    </$list>
  </$let>
	</$wikify>
\end

\define open-cell-details(row, col)
<$action-createtiddler
  $basetitle="$:/temp/cypro/matrix-detail"
  $overwrite="yes"
  tags="matrix-detail"
  caption="Gefährdungsübersicht"
  row="$row$"
  col="$col$"
  value={{{ [[$row$]multiply[$col$]] }}}
  count={{{ [<matches>trim[]split[,]!is[blank]count[]] }}}
  matches={{{ [<matches>split[,]trim[]!is[blank]join[,]] }}}
>
  <$action-navigate $to=<<createTiddler-title>>/>
</$action-createtiddler>
\end



