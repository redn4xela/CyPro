title: $:/plugins/aeckert/cypro/viewtemplates/components/processIdentification
type: text/vnd.tiddlywiki


\procedure cypro-process-create-function()
<!-- Create one function for the service supplied through targetService. -->
<$let
    nextFunctionID={{{ [function[cypro-next-id],[cypro-process-function],[F]] }}}
    nextFunctionOrder={{{ [tag[cypro-process-function]service<targetService>count[]add[1]] }}}
>
<$let
    newFunctionTitle={{{ [<nextFunctionID>addprefix[CyPro-Prozessfunktion-]] }}}
>

<$action-createtiddler
    $basetitle=<<newFunctionTitle>>
    tags="cypro-process-function"
    id=<<nextFunctionID>>
    service=<<targetService>>
    order=<<nextFunctionOrder>>
    caption={{$:/temp/cypro/process-function-new!!caption}}
    function-description={{$:/temp/cypro/process-function-new!!function-description}}
    subfunction-description={{$:/temp/cypro/process-function-new!!subfunction-description}}
    responsible-unit={{$:/temp/cypro/process-function-new!!responsible-unit}}
    completed="no"
    text=""
>
    <$action-setfield
        $tiddler="$:/state/cypro/process-selected-service"
        text=<<targetService>>
    />

    <$action-setfield
        $tiddler="$:/state/cypro/process-selected-function"
        text=<<createTiddler-title>>
    />

    <!-- The function now exists, so close the creation form. -->
    <$action-setfield
        $tiddler="$:/state/cypro/process-new-function-open"
        text="no"
    />

    <$action-setfield
        $tiddler="$:/state/cypro/process-selected-process"
        text=""
    />

    <$action-setfield
        $tiddler="$:/state/cypro/process-task-inventory"
        text=""
    />
</$action-createtiddler>


<$action-setfield
    $tiddler="$:/temp/cypro/process-function-new"
    caption=""
    function-description=""
    subfunction-description=""
    responsible-unit=""
/>

</$let>
</$let>
\end


\procedure cypro-process-add-function()
<!--
  Add a function to the selected service.
  If no service exists yet, create the service first and then the function.
-->
<$let
    selectedService={{{ [[$:/state/cypro/process-selected-service]get[text]] }}}
>

<!-- Existing service. -->
<$list
    filter="[<selectedService>minlength[1]]"
    variable="null"
>

<$let targetService=<<selectedService>>>
<<cypro-process-create-function>>
</$let>

</$list>


<!-- First function of a new service. -->
<$list
    filter="[<selectedService>minlength[1]count[]match[0]]"
    variable="null"
>

<$let
    nextServiceID={{{ [function[cypro-next-id],[cypro-process-service],[S]] }}}
>
<$let
    newServiceTitle={{{ [<nextServiceID>addprefix[CyPro-Prozessdienstleistung-]] }}}
>

<$action-createtiddler
    $basetitle=<<newServiceTitle>>
    tags="cypro-process-service"
    id=<<nextServiceID>>
    caption={{$:/temp/cypro/process-service-new!!caption}}
    text=""
>

    <$let targetService=<<createTiddler-title>>>
    <<cypro-process-create-function>>
    </$let>

</$action-createtiddler>

<$action-setfield
    $tiddler="$:/temp/cypro/process-service-new"
    caption=""
/>

</$let>
</$let>

</$list>

</$let>
\end


\procedure cypro-process-add-process()
<!--
  A process represents one system/data object used by the selected function.
  Create the process and its inventory entry together.
-->
<$let
    selectedFunction={{{ [[$:/state/cypro/process-selected-function]get[text]] }}}
    nextProcessID={{{ [function[cypro-next-id],[cypro-process],[P]] }}}
>

<$let
    nextProcessOrder={{{ [tag[cypro-process]function<selectedFunction>count[]add[1]] }}}
    newProcessTitle={{{ [<nextProcessID>addprefix[CyPro-Prozess-]] }}}
    draftType={{{ [[$:/temp/cypro/process-new]get[object-type]] }}}
    draftProtection={{{ [[$:/temp/cypro/process-new]get[system-protection]] }}}
>

<$let
    effectiveProtection={{{ [<draftType>match[system]then<draftProtection>] }}}
>

<$action-createtiddler
    $basetitle=<<newProcessTitle>>
    tags="cypro-process"
    id=<<nextProcessID>>
    function=<<selectedFunction>>
    order=<<nextProcessOrder>>
    caption={{$:/temp/cypro/process-new!!caption}}
    object-type=<<draftType>>
    system-protection=<<effectiveProtection>>
    provider={{$:/temp/cypro/process-new!!provider}}
    associated-programs={{$:/temp/cypro/process-new!!associated-programs}}
    inventory-item=""
    text=""
>

    <$let processTitle=<<createTiddler-title>>>

    <$let
        maxInventoryNum={{{ [tag[cypro-inventory]prefix[CyPro-Inventar-]removeprefix[CyPro-Inventar-]nsort[]last[]] ~[[000]] }}}
    >
    <$let
        nextInventoryNum={{{ [<maxInventoryNum>add[1]pad[3]] }}}
    >
    <$let
        newInventoryTitle={{{ [<nextInventoryNum>addprefix[CyPro-Inventar-]] }}}
    >

    <$action-createtiddler
        $basetitle=<<newInventoryTitle>>
        tags="cypro-inventory"
        inventory-id=<<nextInventoryNum>>
        caption={{$:/temp/cypro/process-new!!caption}}
        object-type=<<draftType>>
        system-protection=<<effectiveProtection>>
        provider={{$:/temp/cypro/process-new!!provider}}
        associated-programs={{$:/temp/cypro/process-new!!associated-programs}}
        identification-method="process"
        process-links=<<processTitle>>
        aviation-task-status="pending"
        aviation-security-tasks=""
        aviation-security-cargo-tasks=""
        aviation-security-task-other=""
        aviation-security-task-none=""
        assessment-status="identified"
        assessment-result=""
        assessment-reason=""
        text=""
    >

        <$action-setfield
            $tiddler=<<processTitle>>
            inventory-item=<<createTiddler-title>>
        />

        <$action-setfield
            $tiddler="$:/state/cypro/process-selected-process"
            text=<<processTitle>>
        />

        <$action-setfield
            $tiddler="$:/state/cypro/process-task-inventory"
            text=<<createTiddler-title>>
        />

        <!-- Close the creation form after the object has been added. -->
        <$action-setfield
            $tiddler="$:/state/cypro/process-new-open"
            text="no"
        />

    </$action-createtiddler>

    </$let>
    </$let>
    </$let>

    </$let>

</$action-createtiddler>


<$action-setfield
    $tiddler="$:/temp/cypro/process-new"
    caption=""
    object-type=""
    system-protection=""
    provider=""
    associated-programs=""
/>

</$let>
</$let>
</$let>
\end


\procedure cypro-process-complete-task-assignment()
<!-- Complete task assignment and continue directly with the KIKS relevance check. -->
<$let
    selectedInventory={{{ [[$:/state/cypro/process-task-inventory]get[text]] }}}
>

<$action-setfield
    $tiddler=<<selectedInventory>>
    aviation-task-status="completed"
    assessment-status="pending"
    assessment-result=""
    assessment-reason=""
/>

<!-- Reuse the object data already identified in the process-oriented workflow. -->
<$action-setfield
    $tiddler="$:/temp/cypro/kiks-assessment-selected"
    text=<<selectedInventory>>
/>

<$action-setfield
    $tiddler="$:/temp/cypro/kiks-assessment"
    caption={{{ [<selectedInventory>get[caption]] }}}
    original-type={{{ [<selectedInventory>get[object-type]] }}}
    confirmed-type={{{ [<selectedInventory>get[object-type]] }}}
    system-protection={{{ [<selectedInventory>get[system-protection]] }}}
    impact=""
    influence=""
    german-jurisdiction=""
    jurisdiction-reason=""
/>

<$action-setfield
    $tiddler="$:/state/cypro/process-task-inventory"
    text=""
/>

<$action-navigate
    $to="$:/plugins/aeckert/cypro/pages/kiksAssessment"
/>

</$let>
\end


\procedure cypro-process-complete-no-task()
<!-- No aviation-security task means direct non-KIKS classification. -->
<$let
    selectedInventory={{{ [[$:/state/cypro/process-task-inventory]get[text]] }}}
>

<$action-setfield
    $tiddler=<<selectedInventory>>
    aviation-security-tasks=""
    aviation-security-cargo-tasks=""
    aviation-security-task-other=""
    aviation-security-task-none="yes"
    aviation-task-status="completed"
    assessment-status="completed"
    assessment-result="non-kiks"
    assessment-reason="no-aviation-task"
/>

<$action-setfield
    $tiddler="$:/state/cypro/process-task-inventory"
    text=""
/>

</$let>
\end






