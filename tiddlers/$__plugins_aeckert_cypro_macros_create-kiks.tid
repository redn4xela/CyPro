\define kiks-create-action(identificationMethod:"", threatCatalog:"$:/plugins/aeckert/cypro/data/default-threats")
<!--
  Create one regular CyPro KIKS plus all threats from the selected catalog.

  Existing callers remain compatible because data/default-threats stays the
  default catalog. The guided preset path passes data/preset-threats explicitly.
-->
<$vars nextID={{{ [function[cypro-next-id],[KIKS],[K]] }}}>

<$list
  filter="[[$threatCatalog$]indexes[]suffix[.caption]removesuffix[.caption]]"
  variable="suffix"
>
  <$let
    threatTitle={{{ [<nextID>addsuffix<suffix>] }}}
    threat_no={{{ [<suffix>addsuffix[.threat_no]] }}}
    threat_caption={{{ [<suffix>addsuffix[.caption]] }}}
  >
    <$action-createtiddler
      $basetitle=<<threatTitle>>
      tags="threat"
      id=<<threatTitle>>
      kiks=<<nextID>>
      threat_no={{{ [[$threatCatalog$]getindex<threat_no>] }}}
      caption={{{ [[$threatCatalog$]getindex<threat_caption>] }}}
      mandatory="yes"
      initial_impact=""
      initial_probability=""
      final_probability=""
      final_impact=""
      final_risk=""
      applicable=""
      text=""
    />
  </$let>
</$list>

<$action-createtiddler
  $basetitle=<<nextID>>
  tags="KIKS"
  caption=""
  id=<<nextID>>
  identification-method="$identificationMethod$"
  text=""
>
  <$action-navigate $to=<<createTiddler-title>>/>
</$action-createtiddler>

</$vars>
\end


\define kiks-create-manual-action()
<$action-setfield
    $tiddler="$:/cypro/data/kiksIdentificationFlow"
    method="manual"
/>
<<kiks-create-action "manual">>
\end
