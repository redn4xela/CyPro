tags: $:/tags/Stylesheet
list-after: $:/plugins/aeckert/cypro/styles/guidedKIKS
title: $:/plugins/aeckert/cypro/styles/uiCleanup
type: text/css

/* Scoped UI rules; risk and protection calculations remain in their macros. */
:is(.cypro-threat-page, .cypro-measures-section, .cypro-custom-editor-page,
    .cypro-threat-grid-table, .cypro-threat-grid-footer, .cypro-kiks-protection-summary) {
    --cypro-ui-border: #d7dee8;
    --cypro-ui-surface: #f5f7fb;
    --cypro-ui-text: #243247;
    --cypro-ui-muted: #526174;
    --cypro-ui-radius: 10px;
    color: var(--cypro-ui-text);
}

/* Buttons share a minimum height, centered labels and keyboard focus. */
:is(.cypro-threat-page, .cypro-measures-section, .cypro-custom-editor-page,
    .cypro-threat-grid-table, .cypro-threat-grid-footer) button.cypro-btn {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    margin: 0;
    padding: 9px 14px;
    border-radius: 7px;
    font-family: inherit;
    font-size: .875rem;
    font-weight: 600;
    line-height: 1.35;
    text-align: center;
    white-space: normal;
    vertical-align: middle;
}

:is(.cypro-threat-page, .cypro-measures-section, .cypro-custom-editor-page,
    .cypro-threat-grid-table, .cypro-threat-grid-footer) button.cypro-btn p {
    max-width: none;
    margin: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    line-height: inherit;
}

:is(.cypro-threat-page, .cypro-measures-section, .cypro-custom-editor-page,
    .cypro-threat-grid-table, .cypro-threat-grid-footer) button:focus-visible,
.cypro-measures-section .cypro-table-wrap:focus-visible {
    outline: 3px solid #5174c7;
    outline-offset: 3px;
}

/* Initial assessment and workflow cards. */
.cypro-threat-page .cypro-initial-assessment {
    margin: 20px 0 0;
    padding: 20px;
    border: 1px solid var(--cypro-ui-border);
    border-radius: var(--cypro-ui-radius);
    background: #fff;
}

.cypro-threat-page .cypro-initial-assessment > h3 {
    margin: 0 0 16px;
    font-size: 1.05rem;
    font-weight: 700;
}

.cypro-threat-page .cypro-initial-assessment-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 24px;
}

.cypro-threat-page .cypro-initial-applicability {
    grid-column: 1 / -1;
}

.cypro-threat-page .cypro-initial-assessment .kiks-body-area {
    margin: 0;
    padding: 0;
}

.cypro-threat-page .kiks-field-label,
.cypro-measures-section .cypro-package-scale-label {
    margin-bottom: 7px;
    color: #435168;
    font-size: .78rem;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: .025em;
}

.cypro-threat-page .kiks-type-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    max-width: 100%;
}

.cypro-threat-page .kiks-radio-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-height: 36px;
    padding: 8px 11px;
    font-size: .82rem;
    line-height: 1.3;
    text-align: center;
    white-space: normal;
}

.cypro-threat-page .cypro-risk-display {
    margin: 16px 0 24px;
    padding: 14px 16px;
    border: 1px solid var(--cypro-ui-border);
    border-radius: var(--cypro-ui-radius);
    background: var(--cypro-ui-surface);
}

.cypro-threat-page .cypro-measures-section {
    margin-top: 0;
}

.cypro-measures-section .cypro-measure-workflow-step {
    margin: 0 0 20px;
    padding: 20px;
    border: 1px solid var(--cypro-ui-border);
    border-radius: var(--cypro-ui-radius);
    background: #fff;
    box-shadow: none;
}

.cypro-measures-section .cypro-measure-workflow-step-selection {
    border-color: #c6d4ef;
}

.cypro-measures-section .cypro-measure-workflow-step-protection {
    background: #fbfcfe;
}

.cypro-measures-section .cypro-measure-workflow-heading {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 0 0 18px;
}

.cypro-measures-section .cypro-measure-workflow-heading h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.45;
}

.cypro-measures-section .cypro-measure-workflow-heading p {
    max-width: 86ch;
    margin: 4px 0 0;
    color: var(--cypro-ui-muted);
    font-size: .875rem;
    line-height: 1.5;
}

.cypro-measures-section .cypro-measure-workflow-number {
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    background: var(--lba-blue, #051571);
    font-size: .875rem;
    line-height: 1;
}

/* Selection cards and fields. */
.cypro-measures-section .cypro-measure-catalog-toggle {
    margin: 0;
}

.cypro-measures-section .cypro-measure-catalog {
    margin-top: 18px;
    padding: 0;
    border: 0;
    background: transparent;
}

.cypro-measures-section .cypro-measure-catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.cypro-measures-section .cypro-measure-catalog-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border-radius: var(--cypro-ui-radius);
}

.cypro-measures-section .cypro-measure-catalog-card h4 {
    margin: 0;
    font-size: .95rem;
    line-height: 1.45;
}

.cypro-measures-section .cypro-measure-catalog-card > :last-child {
    margin-top: auto;
}

.cypro-measures-section .cypro-existing-measure-search {
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--cypro-ui-border);
}

.cypro-measures-section .cypro-existing-measure-search h4,
.cypro-measures-section .cypro-custom-measure-launch-panel h4 {
    margin: 0 0 8px;
    font-size: .925rem;
    font-weight: 700;
}

.cypro-measures-section .cypro-custom-measure-launch-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-top: 18px;
    padding: 16px;
    border: 1px solid var(--cypro-ui-border);
    border-radius: var(--cypro-ui-radius);
    background: var(--cypro-ui-surface);
}

.cypro-measures-section .cypro-custom-measure-launch-panel > div > p {
    max-width: 76ch;
    margin: 0;
    color: var(--cypro-ui-muted);
    font-size: .875rem;
    line-height: 1.5;
}

.cypro-measures-section .cypro-custom-measure-launch-panel button {
    flex-shrink: 0;
}

:is(.cypro-measures-section, .cypro-custom-editor-page) .cypro-field-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 40px;
    padding: 9px 12px;
    border: 1px solid #bac7d8;
    border-radius: 7px;
    background: #fff;
    color: var(--cypro-ui-text);
    font-family: inherit;
    font-size: .875rem;
    line-height: 1.5;
}

:is(.cypro-measures-section, .cypro-custom-editor-page) .cypro-field-input:focus {
    outline: 2px solid #5174c7;
    outline-offset: 2px;
}

/* Compact status counts keep all four labels visible without empty columns. */
.cypro-measures-section .cypro-package-status-counts-wide {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    min-width: 0;
    margin: 0 0 16px;
}

.cypro-measures-section .cypro-package-status-counts-wide > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    border: 1px solid var(--cypro-ui-border);
    border-radius: 7px;
    background: var(--cypro-ui-surface);
    color: #435168;
    font-size: .8rem;
    line-height: 1.4;
}

/* Each package entry uses the same five columns as its header. */
.cypro-measures-section .cypro-table-wrap {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    border-radius: var(--cypro-ui-radius);
}

.cypro-measures-section .cypro-package-grid-table {
    box-sizing: border-box;
    width: 100%;
    min-width: 960px;
    border: 1px solid var(--cypro-ui-border);
    border-radius: var(--cypro-ui-radius);
    overflow: hidden;
    background: #fff;
}

.cypro-measures-section .cypro-package-grid-header,
.cypro-measures-section .cypro-package-grid-row {
    display: grid;
    grid-template-columns: minmax(240px, 2.4fr) minmax(160px, 1.3fr)
        minmax(210px, 1.6fr) minmax(128px, .9fr) 64px;
    align-items: stretch;
}

.cypro-measures-section .cypro-package-grid-header,
.cypro-measures-section .cypro-catalog-grid-header,
.cypro-threat-grid-table .cypro-threat-grid-header {
    background: #f1f4f9;
    color: #35445b;
    font-size: .8rem;
    font-weight: 700;
}

.cypro-measures-section .cypro-package-grid-header > div,
.cypro-measures-section .cypro-package-grid-cell {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 12px 14px;
    border-right: 1px solid #e5eaf1;
    overflow-wrap: anywhere;
    font-size: .85rem;
    line-height: 1.45;
}

.cypro-measures-section .cypro-package-grid-header > div:last-child,
.cypro-measures-section .cypro-package-grid-cell:last-child {
    border-right: 0;
}

.cypro-measures-section .cypro-package-grid-row {
    border-top: 1px solid #e5eaf1;
}

.cypro-measures-section .cypro-package-grid-row:hover {
    background: #fbfcff;
}

.cypro-measures-section .cypro-package-grid-header > div:nth-last-child(-n+2),
.cypro-measures-section .cypro-package-grid-action,
.cypro-measures-section .cypro-package-grid-remove {
    align-items: center;
    text-align: center;
}

.cypro-measures-section .cypro-measure-title-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
}

.cypro-measures-section .cypro-measure-preview,
.cypro-measures-section .cypro-measure-catalog-meta {
    color: var(--cypro-ui-muted);
    font-size: .8rem;
    line-height: 1.5;
}

.cypro-measures-section .cypro-measure-preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    max-height: 3em;
}

.cypro-measures-section .cypro-package-grid-header > div > p,
.cypro-measures-section .cypro-package-grid-cell p,
.cypro-measures-section .cypro-catalog-grid-header > div > p,
.cypro-measures-section .cypro-catalog-grid-cell p,
.cypro-threat-grid-table .cypro-threat-grid-cell p,
.cypro-threat-grid-table .cypro-threat-grid-header > div > p,
.cypro-custom-editor-page .cypro-custom-editor-field > p {
    margin: 0;
}

.cypro-measures-section p:empty,
.cypro-custom-editor-page p:empty {
    display: none;
}

.cypro-measures-section .cypro-function-chip,
.cypro-measures-section .cypro-measure-origin-badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    box-sizing: border-box;
    max-width: 100%;
    padding: 4px 8px;
    border: 1px solid #d7e1ee;
    border-radius: 6px;
    background: #f1f5fa;
    color: #3c506d;
    font-size: .76rem;
    line-height: 1.4;
    white-space: normal;
}

.cypro-measures-section .cypro-package-grid-action .cypro-measure-origin-badge {
    align-self: center;
}

.cypro-measures-section .cypro-measure-status-options {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
}

.cypro-measures-section .cypro-measure-status-options label {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 20px;
    margin: 0;
    color: #35445b;
    font-size: .8rem;
    line-height: 1.4;
    cursor: pointer;
}

.cypro-measures-section .cypro-measure-status-options input {
    flex: 0 0 auto;
    width: 15px;
    height: 15px;
    margin: 0;
    accent-color: var(--lba-blue, #051571);
}

.cypro-measures-section button.kiks-remove-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 32px;
    min-width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    border: 1px solid #d3dbe7;
    border-radius: 6px;
    background: #fff;
    color: #617087;
    font-size: .8rem;
    line-height: 1;
    cursor: pointer;
}

.cypro-measures-section button.kiks-remove-button p {
    margin: 0;
    color: inherit;
    font: inherit;
}

.cypro-measures-section button.kiks-remove-button:hover {
    border-color: #d8a6a6;
    background: #fff3f3;
    color: #a32929;
}

/* Catalog actions stay at the right, within their own centered cell. */
.cypro-measures-section .cypro-catalog-grid-table {
    min-width: 1040px;
    border-color: var(--cypro-ui-border);
    border-radius: var(--cypro-ui-radius);
}

.cypro-measures-section .cypro-catalog-grid-header,
.cypro-measures-section .cypro-catalog-grid-row {
    display: grid;
    grid-template-columns: 64px minmax(170px, 1.1fr) minmax(320px, 2.6fr)
        minmax(150px, 1fr) 208px;
    align-items: stretch;
}

.cypro-measures-section .cypro-catalog-grid-cell,
.cypro-measures-section .cypro-catalog-grid-header > div,
.cypro-threat-grid-table .cypro-threat-grid-cell,
.cypro-threat-grid-table .cypro-threat-grid-header > div {
    padding: 12px 14px;
    border-right-color: #e5eaf1;
    line-height: 1.45;
}

.cypro-measures-section .cypro-catalog-grid-header > div:last-child,
.cypro-measures-section .cypro-catalog-grid-action {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.cypro-measures-section .cypro-catalog-grid-action button.cypro-btn {
    width: 100%;
    max-width: 180px;
}

.cypro-threat-grid-table .cypro-threat-grid-row {
    align-items: stretch;
}

.cypro-threat-grid-table .cypro-threat-grid-cell {
    display: flex;
    align-items: center;
}

.cypro-threat-grid-table :is(.cypro-threat-grid-action, .cypro-threat-grid-applicability,
    .cypro-threat-grid-number, .cypro-threat-grid-risk, .cypro-threat-grid-protection) {
    justify-content: center;
}

/* Risk values retain the existing thresholds and colors. */
.cypro-measures-section .cypro-package-reassessment {
    margin: 0;
    padding: 0;
    border: 0;
}

.cypro-measures-section .cypro-package-reassessment h4 {
    margin: 0 0 8px;
    font-size: .95rem;
}

.cypro-measures-section .cypro-package-reassessment > p {
    margin: 0 0 16px;
    color: var(--cypro-ui-muted);
    font-size: .875rem;
    line-height: 1.5;
}

.cypro-measures-section .cypro-package-risk-result {
    display: grid;
    grid-template-columns: minmax(120px, 180px) 32px minmax(120px, 180px);
    align-items: center;
    gap: 8px;
    margin-top: 18px;
}

.cypro-measures-section .cypro-package-risk-result > div:not(.cypro-package-arrow) {
    min-width: 0;
    padding: 12px 14px;
    border-color: var(--cypro-ui-border);
    border-radius: 8px;
    background: var(--cypro-ui-surface);
}

.cypro-measures-section .cypro-package-arrow {
    text-align: center;
}

.cypro-measures-section .cypro-package-risk-result strong {
    margin-top: 8px;
}

.cypro-measures-section .cypro-package-risk-result .cypro-risk-badge {
    display: inline-flex;
    min-width: 40px;
    min-height: 32px;
    font-size: 1rem;
}

.cypro-measures-section .cypro-risk-badge-green { color: #235f30; }
.cypro-measures-section .cypro-risk-badge-yellow { color: #6b5610; }
.cypro-measures-section .cypro-risk-badge-orange { color: #7d4315; }
.cypro-measures-section .cypro-risk-badge-red { color: #882620; }

.cypro-measures-section .cypro-package-reassessment-pending {
    margin-top: 12px;
    padding: 12px 14px;
    border: 1px solid #ead5a5;
    border-radius: 8px;
    background: #fff9ec;
    color: #75571c;
    font-size: .85rem;
    line-height: 1.5;
}

.cypro-measures-section .cypro-package-awaiting,
.cypro-measures-section .cypro-package-reassessment-complete {
    margin-top: 12px;
    font-size: .875rem;
    line-height: 1.5;
}

/* The gauge and its explanation share one compact protection card. */
.cypro-measures-section .cypro-protection-panel {
    display: grid;
    grid-template-columns: minmax(300px, 360px) minmax(0, 1fr);
    align-items: start;
    gap: 20px;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
}

.cypro-measures-section .cypro-protection-heading,
.cypro-measures-section .cypro-protection-gaps {
    grid-column: 1 / -1;
}

.cypro-measures-section .cypro-protection-heading {
    flex-wrap: wrap;
}

.cypro-measures-section .cypro-protection-value strong {
    font-size: 1.65rem;
}

.cypro-measures-section .cypro-protection-gauge-wrap {
    min-width: 0;
    margin-top: 0;
}

.cypro-measures-section .cypro-protection-explanation {
    align-self: center;
    margin: 0;
    padding: 0;
    border: 0;
}

.cypro-measures-section .cypro-protection-note,
.cypro-measures-section .cypro-protection-subtitle,
.cypro-measures-section .cypro-protection-legend {
    color: var(--cypro-ui-muted);
    font-size: .8rem;
    line-height: 1.5;
}

.cypro-measures-section .cypro-protection-gaps {
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--cypro-ui-border);
}

/* The separate custom editor uses the same fields, cards and actions. */
.cypro-custom-editor-page .cypro-custom-editor-header,
.cypro-custom-editor-page .cypro-custom-editor-card,
.cypro-kiks-protection-summary {
    padding: 20px;
    border-color: var(--cypro-ui-border);
    border-radius: var(--cypro-ui-radius);
}

.cypro-custom-editor-page .cypro-custom-editor-card h3 {
    margin: 0 0 12px;
    font-size: 1.05rem;
    font-weight: 700;
}

.cypro-custom-editor-page .cypro-custom-editor-help {
    margin: 0 0 16px;
    color: var(--cypro-ui-muted);
    font-size: .875rem;
    line-height: 1.5;
}

.cypro-custom-editor-page button.cypro-custom-editor-option {
    min-height: 96px;
    padding: 14px 16px;
    border-radius: 8px;
    color: var(--cypro-ui-text);
    font-family: inherit;
    font-size: .875rem;
    line-height: 1.45;
    text-align: left;
}

.cypro-custom-editor-page button.cypro-custom-editor-status {
    min-height: 40px;
    padding: 9px 12px;
    border-radius: 7px;
    font-family: inherit;
    font-size: .85rem;
    line-height: 1.35;
    text-align: center;
}

.cypro-custom-editor-page button.cypro-custom-editor-option-active,
.cypro-custom-editor-page button.cypro-custom-editor-status-active {
    border-color: var(--lba-blue, #051571);
    background: #eef1fb;
    color: var(--lba-blue, #051571);
}

.cypro-custom-editor-page .cypro-custom-editor-footer {
    align-items: center;
    gap: 10px;
}

@media (max-width: 900px) {
    .cypro-measures-section .cypro-custom-measure-launch-panel,
    .cypro-measures-section .cypro-protection-panel {
        display: grid;
        grid-template-columns: 1fr;
    }

    .cypro-measures-section .cypro-custom-measure-launch-panel button {
        justify-self: start;
    }

    .cypro-custom-editor-page .cypro-custom-editor-status-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 620px) {
    .cypro-threat-page .cypro-initial-assessment,
    .cypro-measures-section .cypro-measure-workflow-step,
    .cypro-custom-editor-page .cypro-custom-editor-header,
    .cypro-custom-editor-page .cypro-custom-editor-card {
        padding: 14px;
    }

    .cypro-threat-page .cypro-initial-assessment-grid,
    .cypro-measures-section .cypro-measure-catalog-grid,
    .cypro-measures-section .cypro-package-scales,
    .cypro-custom-editor-page .cypro-custom-editor-status-grid {
        grid-template-columns: 1fr;
    }

    .cypro-measures-section .cypro-protection-value {
        align-items: flex-start;
        text-align: left;
    }
}

@media (max-width: 480px) {
    .cypro-measures-section .cypro-protection-gauge {
        margin-inline: -22px;
        margin-bottom: -25px;
        transform: scale(.85);
        transform-origin: 50% 0;
    }

    .cypro-measures-section .cypro-package-risk-result {
        grid-template-columns: minmax(0, 1fr) 24px minmax(0, 1fr);
        gap: 4px;
    }
}

@media print {
    .cypro-measures-section .cypro-table-wrap {
        overflow: visible;
    }

    .cypro-measures-section .cypro-package-grid-table,
    .cypro-measures-section .cypro-catalog-grid-table {
        min-width: 0;
    }

    .cypro-measures-section .cypro-package-grid-header,
    .cypro-measures-section .cypro-package-grid-row {
        grid-template-columns: minmax(0, 2.4fr) minmax(0, 1.3fr)
            minmax(0, 1.6fr) minmax(0, .9fr) 30px;
    }

    .cypro-measures-section .cypro-catalog-grid-header,
    .cypro-measures-section .cypro-catalog-grid-row {
        grid-template-columns: 30px minmax(0, 1.1fr) minmax(0, 2.6fr)
            minmax(0, 1fr) minmax(0, 1.1fr);
    }

    .cypro-measures-section .cypro-package-grid-row,
    .cypro-measures-section .cypro-catalog-grid-row {
        break-inside: avoid;
    }
}

/* Step 7: shared measure editor, validation and matching risk scales. */
.cypro-measures-section .cypro-package-grid-action {
    gap: 8px;
}

.cypro-custom-editor-page .cypro-editor-validation {
    color: #805315;
    font-size: .85rem;
    line-height: 1.5;
}

.cypro-custom-editor-page .cypro-editor-validation p {
    margin: 0 0 4px;
}

.cypro-custom-editor-page button.cypro-editor-save:disabled {
    opacity: .5;
    cursor: not-allowed;
}

.cypro-custom-editor-page button.cypro-custom-editor-option p,
.cypro-custom-editor-page button.cypro-custom-editor-status p {
    margin: 0;
    color: inherit;
    font: inherit;
    line-height: inherit;
}

.cypro-custom-editor-page .cypro-custom-editor-options > p,
.cypro-custom-editor-page .cypro-custom-editor-status-grid > p,
.cypro-custom-editor-page .cypro-custom-editor-footer > p {
    display: contents;
    margin: 0;
}

.cypro-measures-section .cypro-package-scale .kiks-body-area {
    margin: 0;
    padding: 0;
}

.cypro-measures-section .cypro-package-scale .kiks-type-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    padding: 0;
}

.cypro-measures-section .cypro-package-scale .kiks-type-toggle > p {
    display: contents;
    margin: 0;
}

.cypro-measures-section .cypro-package-scales > p {
    display: contents;
    margin: 0;
}
