<div class="kiks-body-area cypro-kiks-modern-field">
    <div class="cypro-kiks-field-heading">
        <div class="kiks-field-label">Typ</div>
        <$list filter="[<currentTiddler>has[source-preset-id]]" variable="null">
            <span class="cypro-prefill-badge">Vorbelegt</span>
        </$list>
    </div>

    <div class="kiks-type-toggle">
        <label class="kiks-radio-label">
            <$radio field="kiks" value="system" disabled={{{ [<isLocked>match[yes]then[yes]else[no]] }}}/>
            System
        </label>
        <label class="kiks-radio-label">
            <$radio field="kiks" value="data" disabled={{{ [<isLocked>match[yes]then[yes]else[no]] }}}/>
            Daten
        </label>
    </div>
</div>
