\define update-risk-actions(threat)
<!--
  Recalculate threat risk.

  Package model:
  - initial risk remains impact x probability;
  - once measure status fields are used, per-measure RI/RP values no longer
    determine the actual residual risk;
  - only implemented measures enable a package reassessment;
  - package_impact and package_probability hold the manual reassessment;
  - planned measures never change final_risk.

  Compatibility:
  - threats whose linked measures have no status fields still use the legacy
    RI/RP model until they are migrated.
-->
<$let
    tiddler={{{ [<__threat__>!is[blank]then<__threat__>else<currentTiddler>] }}}
    assessed={{{ [<tiddler>has[initial_impact]has[initial_probability]then[yes]] }}}
    reductionImpactField={{{ [<tiddler>addsuffix[_RI]] }}}
    reductionProbabilityField={{{ [<tiddler>addsuffix[_RP]] }}}
    measureStatusField={{{ [<tiddler>addsuffix[_STATUS]] }}}
    initialImpact={{{ [<tiddler>get[initial_impact]max[1]min[4]] }}}
    initialProbability={{{ [<tiddler>get[initial_probability]max[1]min[4]] }}}
    initialRisk={{{ [<initialImpact>multiply<initialProbability>] }}}
    statusCount={{{ [tag[measure]tag<tiddler>] :filter[has<measureStatusField>] +[count[]] }}}
    implementedCount={{{ [tag[measure]tag<tiddler>] :filter[get<measureStatusField>match[implemented]] +[count[]] }}}
    packageAssessed={{{ [<tiddler>has[package_impact]has[package_probability]then[yes]] }}}
    packageImpact={{{ [<tiddler>get[package_impact]max[1]min[4]] }}}
    packageProbability={{{ [<tiddler>get[package_probability]max[1]min[4]] }}}
    legacyReductionImpact={{{ [tag[measure]tag<tiddler>get<reductionImpactField>sum[]else[0]] }}}
    legacyReductionProbability={{{ [tag[measure]tag<tiddler>get<reductionProbabilityField>sum[]else[0]] }}}
    legacyFinalImpact={{{ [<initialImpact>add<legacyReductionImpact>max[1]] }}}
    legacyFinalProbability={{{ [<initialProbability>add<legacyReductionProbability>max[1]] }}}
>
<$list filter="[<assessed>match[yes]]" variable="null">
<$action-setfield $tiddler=<<tiddler>> initial_risk=<<initialRisk>>/>
<$list filter="[<statusCount>compare:number:eq[0]]" variable="null">
<$action-setfield
    $tiddler=<<tiddler>>
    final_impact=<<legacyFinalImpact>>
    final_probability=<<legacyFinalProbability>>
    final_risk={{{ [<legacyFinalImpact>multiply<legacyFinalProbability>] }}}
/>
</$list>
<$list filter="[<statusCount>compare:number:gt[0]]" variable="null">
<$list filter="[<implementedCount>compare:number:eq[0]]" variable="null">
<$action-setfield
    $tiddler=<<tiddler>>
    package_impact=""
    package_probability=""
    final_impact=<<initialImpact>>
    final_probability=<<initialProbability>>
    final_risk=<<initialRisk>>
/>
</$list>
<$list filter="[<implementedCount>compare:number:gt[0]]" variable="null">
<$list filter="[<packageAssessed>match[yes]]" variable="null">
<$action-setfield
    $tiddler=<<tiddler>>
    final_impact=<<packageImpact>>
    final_probability=<<packageProbability>>
    final_risk={{{ [<packageImpact>multiply<packageProbability>] }}}
/>
</$list>
<$list filter="[<packageAssessed>!match[yes]]" variable="null">
<$action-setfield
    $tiddler=<<tiddler>>
    final_impact=<<initialImpact>>
    final_probability=<<initialProbability>>
    final_risk=<<initialRisk>>
/>
</$list>
</$list>
</$list>
</$list>
<$list filter="[<assessed>!match[yes]]" variable="null">
<$action-setfield
    $tiddler=<<tiddler>>
    initial_risk=""
    package_impact=""
    package_probability=""
    final_impact=""
    final_probability=""
    final_risk=""
/>
</$list>
</$let>
\end
