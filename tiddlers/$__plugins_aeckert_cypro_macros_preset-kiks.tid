tags: $:/tags/Global
title: $:/plugins/aeckert/cypro/macros/preset-kiks
type: text/vnd.tiddlywiki

\define kiks-preset-create-action(preset)
<!--
  Create a normal KIKS from an Excel-driven preset.
  Applicability is matched by BSI threat number so preset content is not coupled
  to the internal Txx numbering.
-->
<$let
    presetTitle=<<__preset__>>
    presetId={{{ [<presetTitle>get[preset-id]] }}}
    presetName={{{ [<presetTitle>get[name]] }}}
    applicableThreatNos={{{ [<presetTitle>get[applicable-threat-nos]] }}}
>
<$let nextID={{{ [function[cypro-next-id],[KIKS],[K]] }}}>

<<kiks-create-action "manual" "$:/plugins/aeckert/cypro/data/preset-threats">>

<$action-setfield
    $tiddler=<<nextID>>
    caption=<<presetName>>
    kiks={{{ [<presetTitle>get[kiks]] }}}
    confidentiality={{{ [<presetTitle>get[confidentiality]] }}}
    integrity={{{ [<presetTitle>get[integrity]] }}}
    availability={{{ [<presetTitle>get[availability]] }}}
    source-preset-id=<<presetId>>
    source-preset=<<presetTitle>>
    preset-legal-reference={{{ [<presetTitle>get[legal-reference]] }}}
    preset-protection-goal-label={{{ [<presetTitle>get[protection-goal-label]] }}}
    preset-relevance-reason={{{ [<presetTitle>get[relevance-reason]] }}}
    preset-assessment-text={{{ [<presetTitle>get[assessment-text]] }}}
    preset-example={{{ [<presetTitle>get[example]] }}}
    preset-catalog-status={{{ [<presetTitle>get[catalog-status]] }}}
/>

<$list
    filter="[[$:/plugins/aeckert/cypro/data/preset-threats]indexes[]suffix[.caption]removesuffix[.caption]]"
    variable="suffix"
>
<$let threatNoKey={{{ [<suffix>addsuffix[.threat_no]] }}}>
<$let threatNo={{{ [[$:/plugins/aeckert/cypro/data/preset-threats]getindex<threatNoKey>] }}}>
<$action-setfield
    $tiddler={{{ [<nextID>addsuffix<suffix>] }}}
    applicable={{{ [<applicableThreatNos>enlist-input[]match<threatNo>] :then[[yes]] :else[[no]] }}}
/>
</$let>
</$let>
</$list>

</$let>
</$let>
\end
